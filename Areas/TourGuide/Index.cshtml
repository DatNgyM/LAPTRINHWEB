@{
    ViewData["Title"] = "Dashboard - Hướng dẫn viên";
    Layout = "_TourGuideLayout";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3">
            <i class="fas fa-user-tie text-primary"></i> 
            Chào mừng, @(ViewBag.TourGuide?.Name ?? "Hướng dẫn viên")
        </h1>
        <p class="text-muted">Quản lý lịch trình tour của bạn</p>
    </div>
    <div class="text-muted">
        <i class="fas fa-calendar"></i> @DateTime.Now.ToString("dd/MM/yyyy")
    </div>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4>@ViewBag.ActiveToursCount</h4>
                        <p class="mb-0">Tour đang dẫn</p>
                    </div>
                    <i class="fas fa-route fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4>@ViewBag.UpcomingToursCount</h4>
                        <p class="mb-0">Tour sắp tới</p>
                    </div>
                    <i class="fas fa-clock fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4>@ViewBag.CompletedToursCount</h4>
                        <p class="mb-0">Tour đã hoàn thành</p>
                    </div>
                    <i class="fas fa-check-circle fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-secondary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4>@(ViewBag.AverageRating > 0 ? ViewBag.AverageRating.ToString("0.0") : "N/A")</h4>
                        <p class="mb-0">Đánh giá trung bình</p>
                    </div>
                    <i class="fas fa-star fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tour assignments -->
<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fas fa-list"></i> Tour được phân công gần đây
        </h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            @if ((ViewBag.ActiveTours == null || !ViewBag.ActiveTours.Any()) && (ViewBag.UpcomingTours == null || !ViewBag.UpcomingTours.Any()))
            {
                <div class="text-center py-5">
                    <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
                    <h4>Hiện tại không có tour nào được phân công</h4>
                    <p class="text-muted">Các tour sẽ hiển thị ở đây khi bạn được phân công.</p>
                </div>
            }
            else
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Tên Tour</th>
                            <th>Ngày bắt đầu</th>
                            <th>Ngày kết thúc</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.ActiveTours != null)
                        {
                            foreach (var tour in ViewBag.ActiveTours)
                            {
                                <tr>
                                    <td>
                                        <strong>@tour.Name_Tour</strong><br>
                                        <small class="text-muted">@tour.Start_Location → @tour.End_Location</small>
                                    </td>
                                    <td>@tour.Start_Date.ToString("dd/MM/yyyy")</td>
                                    <td>@tour.End_Date.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-success">Đang diễn ra</span>
                                    </td>
                                    <td>
                                        <a asp-action="MySchedule" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> Xem lịch trình
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        
                        @if (ViewBag.UpcomingTours != null)
                        {
                            foreach (var tour in ViewBag.UpcomingTours.Take(3))
                            {
                                <tr>
                                    <td>
                                        <strong>@tour.Name_Tour</strong><br>
                                        <small class="text-muted">@tour.Start_Location → @tour.End_Location</small>
                                    </td>
                                    <td>@tour.Start_Date.ToString("dd/MM/yyyy")</td>
                                    <td>@tour.End_Date.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">Sắp tới</span>
                                    </td>
                                    <td>
                                        <a asp-action="MySchedule" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> Xem lịch trình
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                
                <div class="text-center mt-3">
                    <a asp-action="AssignedTours" class="btn btn-outline-primary">
                        <i class="fas fa-list"></i> Xem tất cả tour
                    </a>
                </div>
            }
        </div>
    </div>
</div>