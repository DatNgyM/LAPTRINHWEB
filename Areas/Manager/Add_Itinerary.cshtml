@page
@model AddItineraryModel
@{
    ViewData["Title"] = "Thêm lịch trình";
    Layout = "_Layout";
}

<div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">
                <i class="fas fa-plus-circle text-primary"></i>
                Thêm lịch trình mới
            </h1>
            <p class="text-muted">Nhập thông tin chi tiết cho lịch trình du lịch</p>
        </div>
        <a asp-page="/ItineraryManagement" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <form method="post">
        <div class="card">
            <div class="card-header">
                Thông tin cơ bản
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Itinerary.TourName" class="form-label">Tên tour</label>
                        <input asp-for="Itinerary.TourName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Itinerary.TourCode" class="form-label">Mã tour</label>
                        <input asp-for="Itinerary.TourCode" class="form-control" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Itinerary.TourType" class="form-label">Loại tour</label>
                    <select asp-for="Itinerary.TourType" class="form-select" required>
                        <option value="">Chọn loại tour</option>
                        <option value="beach">Tour biển</option>
                        <option value="mountain">Tour núi</option>
                        <option value="culture">Tour văn hóa</option>
                        <option value="adventure">Tour mạo hiểm</option>
                        <option value="eco">Tour sinh thái</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="Itinerary.Destination" class="form-label">Điểm đến</label>
                    <input asp-for="Itinerary.Destination" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Itinerary.Description" class="form-label">Mô tả chi tiết</label>
                    <textarea asp-for="Itinerary.Description" class="form-control" rows="4" required></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for="Itinerary.Price" class="form-label">Giá tour (VNĐ)</label>
                    <input asp-for="Itinerary.Price" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Lưu lịch trình
                </button>
            </div>
        </div>
    </form>
</div>
