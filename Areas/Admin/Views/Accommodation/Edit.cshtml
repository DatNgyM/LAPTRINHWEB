@model LAPTRINHWEB.Models.Accommodation
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Lấy danh sách Type từ ViewData do controller truyền xuống
    var types = ViewData["TypeList"] as SelectList;
    ViewData["Title"] = "Chỉnh sửa Nơi ở";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chỉnh sửa Nơi ở - EasyTrips</title>
    <link rel="stylesheet" href="~/css/accommodation.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-cogs me-2"></i><span>Admin Panel</span>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="DashBoard" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i><span>Dashboard</span>
                </a>
            </li>
            <!-- ... các mục sidebar khác ... -->
            <li class="nav-item">
                <a class="nav-link active" asp-area="Admin" asp-controller="Accommodation" asp-action="Index">
                    <i class="fas fa-hotel"></i><span>Quản lý Nơi ở</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="form-card">
            <h1 class="mb-4"><i class="fas fa-edit me-2"></i>Chỉnh sửa Nơi ở</h1>
            <form asp-area="Admin" asp-controller="Accommodation" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="ID_Accommodation" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" asp-items="types" class="form-select"></select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Star_Rating" class="form-label"></label>
                    <input asp-for="Star_Rating" type="number" min="1" max="5" class="form-control" />
                    <span asp-validation-for="Star_Rating" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-area="Admin" asp-controller="Accommodation" asp-action="Index"
                        class="btn btn-secondary me-2">
                        Hủy
                    </a>
                    <button type="submit" class="btn btn-primary">
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
