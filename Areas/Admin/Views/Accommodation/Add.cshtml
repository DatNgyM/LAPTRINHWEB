@model LAPTRINHWEB.Models.Accommodation
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Lấy danh sách Type từ ViewData do controller truyền xuống
    var types = ViewData["TypeList"] as SelectList;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thêm Nơi ở mới - EasyTrips</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/accommodation.css" />
</head>

<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-cogs me-2"></i>
            <span>Admin Panel</span>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" href="../Dashboard/Index.html">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="../Tour/Index.html">
                    <i class="fas fa-map-marked-alt"></i>
                    <span>Quản lý Tour</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="../User/Index.html">
                    <i class="fas fa-users"></i>
                    <span>Quản lý Người dùng</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="../Vehicle/Index.html">
                    <i class="fas fa-bus"></i>
                    <span>Quản lý Phương tiện</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="../Accommodation/Index.html">
                    <i class="fas fa-hotel"></i>
                    <span>Quản lý Nơi ở</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="../Itinerary/Index.html">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Quản lý Lịch trình</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="../TourGuide/Index.html">
                    <i class="fas fa-user-tie"></i>
                    <span>Quản lý HDV</span>
                </a>
            </li>
            <li class="nav-item mt-5">
                <a class="nav-link" href="/">
                    <i class="fas fa-home"></i>
                    <span>Về trang chủ</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="header-with-breadcrumb">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="../Dashboard/Index.html">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="Index.html">Quản lý Nơi ở</a></li>
                    <li class="breadcrumb-item active">Thêm mới</li>
                </ol>
            </nav>
            <h1 class="mb-4">
                <i class="fas fa-plus-circle me-2"></i>Thêm Nơi ở mới
            </h1>
        </div>

        <div class="form-card">
            <form asp-area="Admin" asp-controller="Accommodation" asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" asp-items="types" class="form-select"></select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Star_Rating" class="form-label"></label>
                    <input asp-for="Star_Rating" type="number" min="1" max="5" class="form-control" />
                    <span asp-validation-for="Star_Rating" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-area="Admin" asp-controller="Accommodation" asp-action="Index"
                    class="btn btn-secondary ms-2">Hủy</a>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Form validation
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('accommodationForm');

            form.addEventListener('submit', function (event) {
                event.preventDefault();

                // Kiểm tra từng trường
                const name = document.getElementById('Name');
                const type = document.getElementById('Type');
                const address = document.getElementById('Address');
                const city = document.getElementById('City');
                const price = document.getElementById('PricePerNight');
                const maxGuests = document.getElementById('MaxGuests');
                const rating = document.querySelector('input[name="Rating"]:checked');

                let isValid = true;

                // Kiểm tra tên
                if (!name.value.trim()) {
                    name.classList.add('is-invalid');
                    isValid = false;
                } else {
                    name.classList.remove('is-invalid');
                    name.classList.add('is-valid');
                }

                // Kiểm tra loại
                if (!type.value) {
                    type.classList.add('is-invalid');
                    isValid = false;
                } else {
                    type.classList.remove('is-invalid');
                    type.classList.add('is-valid');
                }

                // Kiểm tra địa chỉ
                if (!address.value.trim()) {
                    address.classList.add('is-invalid');
                    isValid = false;
                } else {
                    address.classList.remove('is-invalid');
                    address.classList.add('is-valid');
                }

                // Kiểm tra thành phố
                if (!city.value.trim()) {
                    city.classList.add('is-invalid');
                    isValid = false;
                } else {
                    city.classList.remove('is-invalid');
                    city.classList.add('is-valid');
                }

                // Kiểm tra giá
                if (!price.value || parseFloat(price.value) < 0) {
                    price.classList.add('is-invalid');
                    isValid = false;
                } else {
                    price.classList.remove('is-invalid');
                    price.classList.add('is-valid');
                }

                // Kiểm tra số khách
                if (!maxGuests.value || parseInt(maxGuests.value) < 1) {
                    maxGuests.classList.add('is-invalid');
                    isValid = false;
                } else {
                    maxGuests.classList.remove('is-invalid');
                    maxGuests.classList.add('is-valid');
                }

                // Kiểm tra đánh giá sao
                if (!rating) {
                    document.querySelector('.rating-input').classList.add('is-invalid');
                    isValid = false;
                } else {
                    document.querySelector('.rating-input').classList.remove('is-invalid');
                }

                if (isValid) {
                    // Trong môi trường tĩnh, chuyển hướng về trang danh sách
                    alert('Đã thêm nơi ở thành công!');
                    window.location.href = 'Index.html';
                }
            });
        });

        // Hàm xem trước hình ảnh
        function previewImage(event) {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = '';

            const file = event.target.files[0];
            if (file) {
                const img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.onload = function () {
                    URL.revokeObjectURL(this.src);
                }
                preview.appendChild(img);
            } else {
                preview.innerHTML = '<p class="text-muted">Chưa có hình ảnh</p>';
            }
        }
    </script>
</body>

</html>