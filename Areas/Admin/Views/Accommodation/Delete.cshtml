@model LAPTRINHWEB.Models.Accommodation
@{
    ViewData["Title"] = "Xóa Nơi ở";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyTrips</title>
    <link rel="stylesheet" href="~/css/accommodation.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-cogs me-2"></i><span>Admin Panel</span>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="DashBoard" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i><span>Dashboard</span>
                </a>
            </li>
            <!-- các mục sidebar khác giữ nguyên -->
            <li class="nav-item">
                <a class="nav-link active" asp-area="Admin" asp-controller="Accommodation" asp-action="Index">
                    <i class="fas fa-hotel"></i><span>Quản lý Nơi ở</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="delete-card">
            <h1 class="mb-4 text-danger">
                <i class="fas fa-trash-alt me-2"></i>@ViewData["Title"]
            </h1>
            <div class="alert alert-warning">
                Bạn đang xóa: <strong>@Model.Name</strong><br />
                Địa chỉ: @Model.Address<br />
                Loại: @Model.Type
            </div>
            <div class="card mb-4">
                <div class="card-header"><strong>Chi tiết Nơi ở</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Tên</dt>
                        <dd class="col-sm-9">@Model.Name</dd>
                        <dt class="col-sm-3">Loại</dt>
                        <dd class="col-sm-9">@Model.Type</dd>
                        <dt class="col-sm-3">Địa chỉ</dt>
                        <dd class="col-sm-9">@Model.Address</dd>
                        <dt class="col-sm-3">Điện thoại</dt>
                        <dd class="col-sm-9">@Model.Phone</dd>
                        <dt class="col-sm-3">Đánh giá</dt>
                        <dd class="col-sm-9">
                            @for (int i = 0; i < (@Model.Star_Rating ?? 0); i++)
                            {
                                <i class="fas fa-star text-warning"></i>
                            }
                            @for (int i = (@Model.Star_Rating ?? 0); i < 5; i++)
                            {
                                <i class="far fa-star text-warning"></i>
                            }
                        </dd>
                        <dt class="col-sm-3">Mô tả</dt>
                        <dd class="col-sm-9">@Model.Description</dd>
                    </dl>
                </div>
            </div>

            <form asp-area="Admin" asp-controller="Accommodation" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="ID_Accommodation" type="hidden" />
                <div class="d-flex justify-content-end">
                    <a asp-area="Admin" asp-controller="Accommodation" asp-action="Index"
                        class="btn btn-secondary me-2">
                        <i class="fas fa-arrow-left"></i> Hủy
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt"></i> Xác nhận xóa
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>





}


}
