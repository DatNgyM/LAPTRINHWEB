@model LAPTRINHWEB.Models.ApplicationUser
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var currentRole = ViewBag.CurrentRole as string;
    var selManager = currentRole == "Manager" ? "selected=\"selected\"" : "";
    var selTourGuide = currentRole == "TourGuide" ? "selected=\"selected\"" : "";
}

@{
    ViewData["Title"] = "Chỉnh sửa Người dùng - EasyTrips";
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* CSS giống với trang Index và Create */
        .sidebar {
            height: 100vh;
            background: linear-gradient(180deg, #2c3e50 0%, #34495e 100%);
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
        }

        .sidebar .nav-link {
            color: #ecf0f1;
            padding: 12px 20px;
            border-radius: 0;
            transition: all 0.3s ease;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: #3498db;
            color: white;
        }

        .sidebar-brand {
            background-color: #1a252f;
            padding: 20px;
            text-align: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }

        /* Form styles */
        .form-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-card .card-header {
            background-color: #3498db;
            color: white;
            border-radius: 10px 10px 0 0;
        }

        .required-field::after {
            content: " *";
            color: red;
        }
    </style>
</head>

<body>
    <!-- Sidebar - Giống với trang Index -->
    <nav class="sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-cogs"></i> Admin Panel
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Tour" asp-action="Index">
                    <i class="fas fa-map-marked-alt"></i> Quản lý Tour
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="fas fa-users"></i> Quản lý Người dùng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Transportations">
                    <i class="fas fa-bus"></i> Quản lý Phương tiện
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Accommodations">
                    <i class="fas fa-bed"></i> Quản lý Nơi ở
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Itineraries">
                    <i class="fas fa-route"></i> Quản lý Lịch trình
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="TourGuides">
                    <i class="fas fa-user-tie"></i> Quản lý HDV
                </a>
            </li>
            <hr class="text-white">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index" asp-area="">
                    <i class="fas fa-home"></i> Về trang chủ
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">
                <i class="fas fa-user-edit text-primary"></i>
                Chỉnh sửa Người Dùng
            </h1>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>

        <!-- Form -->
        <div class="card form-card">
            <div class="card-header">
                <h5 class="card-title mb-0">Thông tin người dùng: @Model.UserName</h5>
            </div>
            <div class="card-body">
                <!-- Sửa form action -->
                <form action="/Admin/User/Edit" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="email" class="form-label required-field">Email (Tên đăng nhập)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input type="email" id="email" name="email" class="form-control" value="@Model.Email"
                                    required />
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="fullName" class="form-label required-field">Họ và tên</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input type="text" id="fullName" name="fullName" class="form-control"
                                    value="@Model.Full_Name" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="phoneNumber" class="form-label">Số điện thoại</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                <input type="text" id="phoneNumber" name="phoneNumber" class="form-control"
                                    value="@Model.PhoneNumber" />
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="newRole" class="form-label required-field">Vai trò</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                                <select id="newRole" name="newRole" class="form-select">
                                    <option value="">-- Không thay đổi --</option>
                                    <option value="Manager" @Html.Raw(selManager)>Manager</option>
                                    <option value="TourGuide" @Html.Raw(selTourGuide)>TourGuide</option>
                                </select>
                            </div>
                            <div class="form-text">Vai trò hiện tại: @ViewBag.CurrentRole</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="newPassword" class="form-label">Mật khẩu mới</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input type="password" id="newPassword" name="newPassword" class="form-control"
                                    minlength="6" />
                            </div>
                            <div class="form-text">Để trống nếu không thay đổi mật khẩu</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="address" class="form-label">Địa chỉ</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                <input type="text" id="address" name="address" class="form-control"
                                    value="@Model.Address" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="emailConfirmed"
                                    id="emailConfirmed" @(Model.EmailConfirmed ? "checked" : "")>
                                <label class="form-check-label" for="emailConfirmed">Đã xác thực email</label>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fas fa-save"></i> Lưu thay đổi
                        </button>
                        <!-- Sửa nút quay lại -->
                        <a href="/Admin/User/Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>