@model List<LAPTRINHWEB.Models.Transportation>
@{
    ViewData["Title"] = "Quản lý Phương tiện - Admin";
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Phương tiện - EasyTrips</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #6c757d;
            --success-color: #28a745;
            --info-color: #17a2b8;
            --warning-color: #ffc107;
            --danger-color: #dc3545;
        }

        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Sidebar styling */
        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 260px;
            padding: 0;
            background-color: #343a40;
            color: white;
            overflow-y: auto;
            z-index: 100;
        }

        .sidebar-header {
            padding: 15px;
            background-color: #2c3136;
            text-align: center;
            font-size: 1.5rem;
            font-weight: bold;
        }

        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.75);
            padding: 12px 15px;
            transition: 0.3s all;
            display: flex;
            align-items: center;
        }

        .sidebar .nav-link i {
            margin-right: 10px;
            width: 20px;
        }

        .sidebar .nav-link:hover {
            color: white;
            background-color: #3a4047;
        }

        .sidebar .nav-link.active {
            color: white;
            background-color: var(--primary-color);
        }

        /* Main content */
        .main-content {
            margin-left: 260px;
            padding: 20px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .sidebar {
                width: 50px;
            }

            .sidebar-header {
                padding: 10px;
                font-size: 0;
            }

            .sidebar .nav-link span,
            .sidebar .sidebar-header span {
                display: none;
            }

            .sidebar .nav-link i {
                margin-right: 0;
            }

            .main-content {
                margin-left: 50px;
            }
        }

        /* Table styling */
        .vehicle-table {
            background-color: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .vehicle-table th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
        }

        /* Search & Filter Box */
        .search-box {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
        }

        /* Alert styling */
        .alert-dismissible {
            animation: fadeOut 5s forwards;
            animation-delay: 3s;
        }

        @@keyframes fadeOut {
            from {
                opacity: 1;
            }

            to {
                opacity: 0;
                visibility: hidden;
            }
        }

        /* Header with date */
        .header-with-date {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #dee2e6;
        }

        .current-date {
            font-size: 1rem;
            color: var(--secondary-color);
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-cogs me-2"></i>
            <span>Admin Panel</span>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="DashBoard" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Tour" asp-action="Index">
                    <i class="fas fa-map-marked-alt"></i>
                    <span>Quản lý Tour</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="fas fa-users"></i>
                    <span>Quản lý Người dùng</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-area="Admin" asp-controller="Transportation" asp-action="Index">
                    <i class="fas fa-bus"></i>
                    <span>Quản lý Phương tiện</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Accommodation" asp-action="Index">
                    <i class="fas fa-hotel"></i>
                    <span>Quản lý Nơi ở</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Itinerary" asp-action="Index">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Quản lý Lịch trình</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="TourGuide" asp-action="Index">
                    <i class="fas fa-user-tie"></i>
                    <span>Quản lý HDV</span>
                </a>
            </li>
            <li class="nav-item mt-5">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="HomePage">
                    <i class="fas fa-home"></i>
                    <span>Về trang chủ</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="header-with-date">
            <h1><i class="fas fa-bus me-2"></i>Quản lý Phương tiện</h1>
            <div class="current-date">
                <i class="far fa-calendar-alt me-1"></i> 13/06/2025
            </div>
        </div>

        <!-- Success Alert -->
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> Thao tác thành công!
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <!-- Search & Filter Box -->


        <!-- Add Vehicle Button -->
        <div class="mb-3">
            <a asp-action="Add" class="btn btn-success">
                <i class="fas fa-plus me-1"></i> Thêm Phương tiện mới
            </a>
        </div>

        <!-- Vehicle Table -->
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tên</th>
                            <th>Loại</th>
                            <th>Số chỗ</th>
                            <th>Mô tả</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Type</td>
                                    <td>@item.Capacity</td>
                                    <td>@item.Description</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.ID_Transport" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ID_Transport" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ID_Transport" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">Không tìm thấy phương tiện nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-hide alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
</body>

</html>
