@using LAPTRINHWEB.Models
@model IEnumerable<LAPTRINHWEB.Models.Booking>
@{
    ViewData["Title"] = "Quản lý Booking theo Tour";
    var tours = ViewBag.Tours as List<LAPTRINHWEB.Models.Tour>;
    int selectedTourId = ViewBag.SelectedTourId ?? 0;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body {
            background-color: #f4f6f9;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: linear-gradient(180deg, #2c3e50 0%, #34495e 100%);
            color: white;
            padding: 0;
            min-height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
        }

        .sidebar-header {
            background-color: #1a252f;
            padding: 20px;
            text-align: center;
            font-weight: bold;
            font-size: 1.2rem;
            letter-spacing: 1px;
        }

        .sidebar .nav-link {
            color: #ecf0f1;
            padding: 14px 24px;
            border-radius: 0;
            transition: all 0.3s;
            font-size: 16px;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: #3498db;
            color: white;
        }

        .main-content {
            margin-left: 250px;
            padding: 32px 24px 24px 24px;
            width: 100%;
        }

        h2 {
            margin-bottom: 30px;
            font-weight: bold;
            color: #2d3e50;
        }

        .form-select {
            display: inline-block;
            width: 300px;
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #ced4da;
            font-size: 16px;
        }

        .btn-primary {
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: #fff;
            font-weight: 500;
            padding: 8px 22px;
            border-radius: 6px;
            transition: background 0.2s;
        }

        .btn-primary:hover {
            background: linear-gradient(90deg, #764ba2 0%, #667eea 100%);
        }

        .table {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 40px;
        }

        .table th,
        .table td {
            vertical-align: middle !important;
            text-align: center;
        }

        .table thead th {
            background: #f4f6fa;
            color: #333;
            font-weight: 600;
            font-size: 16px;
        }

        .badge {
            font-size: 14px;
            padding: 6px 14px;
            border-radius: 12px;
        }

        .bg-warning {
            background-color: #ffe082 !important;
            color: #795548 !important;
        }

        .bg-success {
            background-color: #81c784 !important;
            color: #fff !important;
        }

        .bg-danger {
            background-color: #e57373 !important;
            color: #fff !important;
        }

        .btn-success.btn-sm,
        .btn-danger.btn-sm {
            padding: 4px 12px;
            font-size: 14px;
            margin-right: 4px;
        }

        .btn-success i,
        .btn-danger i {
            margin-right: 4px;
        }

        .text-muted {
            color: #b0b0b0 !important;
        }

        @@media (max-width: 991px) {
            .sidebar {
                position: static;
                width: 100%;
                min-height: unset;
            }

            .main-content {
                margin-left: 0;
                padding: 16px 4px;
            }
        }
    </style>
</head>

<body>
    <!-- Sidebar Admin Panel -->
    <nav class="sidebar d-flex flex-column">
        <div class="sidebar-header">
            <i class="fas fa-cogs me-2"></i>
            <span>Admin Panel</span>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="DashBoard" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Tour" asp-action="Index">
                    <i class="fas fa-map-marked-alt"></i> Quản lý Tour
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-area="Admin" asp-controller="Booking" asp-action="Index">
                    <i class="fas fa-bookmark"></i> Quản lý Booking
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="fas fa-users"></i> Quản lý Người dùng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Accommodation" asp-action="Index">
                    <i class="fas fa-bed"></i> Quản lý Nơi ở
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Transportation" asp-action="Index">
                    <i class="fas fa-bus"></i> Quản lý Phương tiện
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Itenerary" asp-action="Index">
                    <i class="fas fa-route"></i> Quản lý Lịch trình
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="TourGuide" asp-action="Index">
                    <i class="fas fa-user-tie"></i> Quản lý HDV
                </a>
            </li>
            <li class="nav-item mt-3">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="HomePage">
                    <i class="fas fa-home"></i> Về trang chủ
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <h2>Quản lý Booking theo Tour</h2>

        <form method="get" asp-action="Index" asp-controller="Booking" asp-area="Admin" class="mb-4">
            <label for="tourId" class="me-2 fw-semibold">Chọn tour:</label>
            <select id="tourId" name="tourId" class="form-select" style="width: 300px; display: inline-block;">
                <option value="0">-- Tất cả tour --</option>
                @if (tours != null)
                {
                    foreach (var tour in tours)
                    {
                        <option value="@tour.ID_Tour" selected="@(tour.ID_Tour == selectedTourId ? "selected" : null)">
                            @tour.Name_Tour (@tour.DepartureDate.ToString("dd/MM/yyyy"))
                        </option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-primary ms-2"><i class="fas fa-search me-1"></i> Xem booking</button>
        </form>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-bordered table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Booking</th>
                            <th>Tour</th>
                            <th>Khách hàng</th>
                            <th>Số lượng</th>
                            <th>Ngày đặt</th>
                            <th>Ngày khởi hành</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">Không có booking nào cho tour này.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var booking in Model)
                            {
                                <tr>
                                    <td>@booking.ID_Booking</td>
                                    <td>@booking.Tour?.Name_Tour</td>
                                    @booking.User?.Full_Name <br />
                                    <td>@booking.Quantity</td>
                                    <td>@booking.Booking_Date.ToString("dd/MM/yyyy")</td>
                                    <td>@booking.Tour?.DepartureDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (booking.Status == BookingStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                        }
                                        else if (booking.Status == BookingStatus.Completed)
                                        {
                                            <span class="badge bg-success">Đã duyệt</span>
                                        }
                                        else if (booking.Status == BookingStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">Đã huỷ</span>
                                        }
                                    </td>
                                    <td>
                                        @if (booking.Status == BookingStatus.Pending)
                                        {
                                            <form asp-action="Approve" asp-controller="Booking" asp-area="Admin" method="post"
                                                style="display:inline;">
                                                <input type="hidden" name="id" value="@booking.ID_Booking" />
                                                <button type="submit" class="btn btn-success btn-sm"
                                                    onclick="return confirm('Duyệt booking này?')">
                                                    <i class="fas fa-check"></i> Duyệt
                                                </button>
                                            </form>
                                            <form asp-action="Cancel" asp-controller="Booking" asp-area="Admin" method="post"
                                                style="display:inline;">
                                                <input type="hidden" name="id" value="@booking.ID_Booking" />
                                                <button type="submit" class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Huỷ booking này?')">
                                                    <i class="fas fa-times"></i> Huỷ
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>