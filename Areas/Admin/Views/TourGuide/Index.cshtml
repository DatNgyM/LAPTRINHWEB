@model IEnumerable<LAPTRINHWEB.Models.TourGuide>
@{
    ViewData["Title"] = "Quản lý Hướng dẫn viên";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f6f9;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background-color: #343a40;
            color: white;
            padding: 15px 0;
            height: 100vh;
            position: fixed;
        }

        .sidebar-item {
            padding: 12px 20px;
            display: flex;
            align-items: center;
            transition: all 0.3s;
            cursor: pointer;
        }

        .sidebar-item:hover {
            background-color: #4b545c;
        }

        .sidebar-item.active {
            background-color: #007bff;
        }

        .sidebar-item i {
            margin-right: 10px;
        }

        .content {
            flex: 1;
            padding: 20px;
            margin-left: 250px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }

        .btn {
            padding: 8px 15px;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
            color: white;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .btn:hover {
            background-color: #0069d9;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background-color: white;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        th,
        td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: #f2f2f2;
        }

        tr:hover {
            background-color: #f5f5f5;
        }

        .action-buttons .btn {
            margin-right: 5px;
            padding: 5px 10px;
            font-size: 0.9em;
        }

        .delete-btn {
            background-color: #dc3545;
        }

        .delete-btn:hover {
            background-color: #c82333;
        }

        .edit-btn {
            background-color: #ffc107;
            color: #212529;
        }

        .edit-btn:hover {
            background-color: #e0a800;
        }

        .view-btn {
            background-color: #17a2b8;
        }

        .view-btn:hover {
            background-color: #138496;
        }

        .search-bar {
            display: flex;
            margin-bottom: 20px;
        }

        .search-bar input {
            flex: 1;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px 0 0 4px;
        }

        .search-bar button {
            padding: 8px 15px;
            background-color: #007bff;
            border: none;
            border-radius: 0 4px 4px 0;
            color: white;
            cursor: pointer;
        }

        .pagination {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        .pagination a {
            color: black;
            padding: 8px 16px;
            text-decoration: none;
            background-color: white;
            border: 1px solid #ddd;
            margin: 0 4px;
        }

        .pagination a.active {
            background-color: #007bff;
            color: white;
            border: 1px solid #007bff;
        }

        .pagination a:hover:not(.active) {
            background-color: #ddd;
        }

        .status-active {
            color: #28a745;
            font-weight: bold;
        }

        .status-inactive {
            color: #dc3545;
            font-weight: bold;
        }

        .avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
        }

        .tour-guide-info {
            display: flex;
            align-items: center;
        }

        .tour-guide-info img {
            margin-right: 10px;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <div class="sidebar-item">
            <i class="fas fa-chart-line"></i>
            <span>Dashboard</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-map-marked-alt"></i>
            <span>Quản lý Tour</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-users"></i>
            <span>Quản lý Người dùng</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-bus"></i>
            <span>Quản lý Phương tiện</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-hotel"></i>
            <span>Quản lý Nơi ở</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-calendar-alt"></i>
            <span>Quản lý Lịch trình</span>
        </div>
        <div class="sidebar-item active">
            <i class="fas fa-user-tie"></i>
            <span>Quản lý HDV</span>
        </div>
        <div class="sidebar-item mt-5">
            <i class="fas fa-home"></i>
            <span>Về trang chủ</span>
        </div>
    </div>

    <div class="content">
        <div class="header">
            <h2>Quản lý Hướng dẫn viên</h2>
            <a href="@Url.Action("Add", "TourGuide", new { area = "Admin" })" class="btn">
                <i class="fas fa-plus"></i> Thêm HDV mới
            </a>
        </div>

        <div class="search-bar">
            <input type="text" placeholder="Tìm kiếm hướng dẫn viên..." />
            <button type="button"><i class="fas fa-search"></i></button>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Hướng dẫn viên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Kinh nghiệm</th>
                    <th>Khu vực</th>
                    <th>Chuyên môn</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var guide in Model)
                {
                    <tr>
                        <td>@guide.ID_Guide</td>
                        <td>
                            <div class="tour-guide-info">
                                <span>@guide.FullName</span>
                            </div>
                        </td>
                        <td>@guide.Email</td>
                        <td>@guide.Phone</td>
                        <td>@guide.Experience năm</td>
                        <td>@guide.Area</td>
                        <td>@guide.Specialization</td>
                        <td class="action-buttons">
                            <a href="@Url.Action("Edit", "TourGuide", new { id = guide.ID_Guide, area = "Admin" })"
                                class="btn edit-btn">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("Delete", "TourGuide", new { id = guide.ID_Guide, area = "Admin" })"
                                class="btn delete-btn">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination">
            <!-- Pagination nếu cần -->
        </div>
    </div>
</body>

</html>