@{
    ViewData["Title"] = "Bảng điều khiển Admin - EasyTrips";
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .sidebar {
            height: 100vh;
            background: linear-gradient(180deg, #2c3e50 0%, #34495e 100%);
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
        }

        .sidebar .nav-link {
            color: #ecf0f1;
            padding: 12px 20px;
            border-radius: 0;
            transition: all 0.3s ease;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: #3498db;
            color: white;
        }

        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-card.success {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        .stat-card.warning {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        .stat-card.info {
            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        }

        .stat-card.danger {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        }

        .sidebar-brand {
            background-color: #1a252f;
            padding: 20px;
            text-align: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-cogs"></i> Admin Panel
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link active" asp-area="Admin" asp-controller="DashBoard" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Tour" asp-action="Index">
                    <i class="fas fa-map-marked-alt"></i> Quản lý Tour
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="fas fa-users"></i> Quản lý Người dùng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Transportation" asp-action="Index">
                    <i class="fas fa-bus"></i> Quản lý Phương tiện
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Accommodation" asp-action="Index">
                    <i class="fas fa-bed"></i> Quản lý Nơi ở
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Itenerary" asp-action="Index">
                    <i class="fas fa-route"></i> Quản lý Lịch trình
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="TourGuide" asp-action="Index">
                    <i class="fas fa-user-tie"></i> Quản lý HDV
                </a>
            </li>
            <li class="nav-item mt-3">
                <a class="btn btn-primary w-100" asp-area="Admin" asp-controller="DashBoard" asp-action="Add">
                    <i class="fas fa-plus"></i> Thêm Tour
                </a>
            </li>
            <hr class="text-white" />
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="HomePage">
                    <i class="fas fa-home"></i> Về trang chủ
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Mobile Menu Toggle -->
        <button class="btn btn-primary d-md-none mb-3" type="button" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i> Menu
        </button>

        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">
                <i class="fas fa-tachometer-alt text-primary"></i>
                Bảng điều khiển Admin
            </h1>
            <div class="text-muted">
                <i class="fas fa-calendar"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row">
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-0">--</h3>
                            <p class="mb-0">Tổng số Tour</p>
                        </div>
                        <div class="ml-auto">
                            <i class="fas fa-map-marked-alt fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card success">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-0">--</h3>
                            <p class="mb-0">Tour đang hoạt động</p>
                        </div>
                        <div class="ml-auto">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card warning">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-0">--</h3>
                            <p class="mb-0">Tổng Người dùng</p>
                        </div>
                        <div class="ml-auto">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card info">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-0">--</h3>
                            <p class="mb-0">Tổng Đặt tour</p>
                        </div>
                        <div class="ml-auto">
                            <i class="fas fa-bookmark fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Card -->
        <div class="row">
            <div class="col-12">
                <div class="stat-card danger">
                    <div class="text-center">
                        <h2 class="mb-2">-- VND</h2>
                        <p class="mb-0"><i class="fas fa-money-bill-wave"></i> Tổng doanh thu</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Data -->
        <div class="row">
            <!-- Recent Tours -->
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-map-marked-alt text-primary"></i>
                            Tour mới nhất
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted text-center">Đang tải dữ liệu...</p>
                    </div>
                </div>
            </div>

            <!-- Recent Bookings -->
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-bookmark text-success"></i>
                            Đặt tour gần đây
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted text-center">Đang tải dữ liệu...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-bolt text-warning"></i>
                            Thao tác nhanh
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2 col-6 mb-3">
                                <a asp-action="Add" class="btn btn-primary w-100">
                                    <i class="fas fa-plus"></i><br>
                                    <small>Thêm Tour</small>
                                </a>
                            </div>
                            <div class="col-md-2 col-6 mb-3">
                                <a asp-area="Admin" asp-controller="User" asp-action="Index"
                                    class="btn btn-success w-100">
                                    <i class="fas fa-user-plus"></i><br>
                                    <small>QL User</small>
                                </a>
                            </div>
                            <div class="col-md-2 col-6 mb-3">
                                <a asp-action="Transportations" class="btn btn-info w-100">
                                    <i class="fas fa-bus"></i><br>
                                    <small>QL PT</small>
                                </a>
                            </div>
                            <div class="col-md-2 col-6 mb-3">
                                <a asp-action="Accommodations" class="btn btn-warning w-100">
                                    <i class="fas fa-bed"></i><br>
                                    <small>QL Nơi ở</small>
                                </a>
                            </div>
                            <div class="col-md-2 col-6 mb-3">
                                <a asp-action="Itineraries" class="btn btn-secondary w-100">
                                    <i class="fas fa-route"></i><br>
                                    <small>QL LT</small>
                                </a>
                            </div>
                            <div class="col-md-2 col-6 mb-3">
                                <a asp-action="TourGuides" class="btn btn-dark w-100">
                                    <i class="fas fa-user-tie"></i><br>
                                    <small>QL HDV</small>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.querySelector('.sidebar').classList.toggle('show');
        }
    </script>
</body>

</html>