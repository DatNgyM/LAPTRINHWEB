@model List<LAPTRINHWEB.Models.Itinerary>
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Hành trình</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f6f9;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            height: 100vh;
            background: linear-gradient(180deg, #2c3e50 0%, #34495e 100%);
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            overflow-y: auto;
        }

        /* Phần adminpanel giống với Dashboard */
        .sidebar-brand {
            background-color: #1a252f;
            padding: 20px;
            text-align: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .sidebar-brand i {
            margin-right: 8px;
        }

        .sidebar-item {
            padding: 12px 20px;
            display: flex;
            align-items: center;
            transition: all 0.3s;
            cursor: pointer;
            color: #ddd;
        }

        .sidebar-item:hover {
            background-color: #4b545c;
        }

        .sidebar-item.active {
            background-color: #007bff;
        }

        .sidebar-item i {
            margin-right: 10px;
        }

        .main-content,
        .content {
            margin-left: 250px;
            padding: 20px;
            flex: 1;
        }

        .header-with-date {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }

        .btn {
            padding: 8px 15px;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
            color: white;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .btn:hover {
            background-color: #0069d9;
        }

        .btn-success {
            background-color: #28a745;
        }

        .btn-success:hover {
            background-color: #218838;
        }

        .btn-warning {
            background-color: #ffc107;
            color: #212529;
        }

        .btn-warning:hover {
            background-color: #e0a800;
        }

        .btn-danger {
            background-color: #dc3545;
        }

        .btn-danger:hover {
            background-color: #c82333;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            background-color: white;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        th,
        td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
            vertical-align: top;
        }

        th {
            background-color: #f2f2f2;
        }

        tr:hover {
            background-color: #f5f5f5;
        }

        .group-title {
            margin-top: 30px;
            margin-bottom: 10px;
            color: #007bff;
            font-size: 20px;
            font-weight: 600;
        }

        .detail-list {
            list-style-type: none;
            padding-left: 0;
            margin: 0;
        }

        .detail-list li {
            border-bottom: 1px dotted #ccc;
            margin-bottom: 5px;
            padding-bottom: 3px;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <nav class="sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-cogs"></i> Admin Panel
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="DashBoard" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Tour" asp-action="Index">
                    <i class="fas fa-map-marked-alt"></i> Quản lý Tour
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="fas fa-users"></i> Quản lý Người dùng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Transportation" asp-action="Index">
                    <i class="fas fa-bus"></i> Quản lý Phương tiện
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Accommodation" asp-action="Index">
                    <i class="fas fa-bed"></i> Quản lý Nơi ở
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-area="Admin" asp-controller="Itenerary" asp-action="Index">
                    <i class="fas fa-route"></i> Quản lý Lịch trình
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="DashBoard" asp-action="TourGuide">
                    <i class="fas fa-user-tie"></i> Quản lý HDV
                </a>
            </li>
            <li class="nav-item mt-3">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="HomePage">
                    <i class="fas fa-home"></i> Về trang chủ
                </a>
            </li>
        </ul>
    </nav>
    <div class="main-content">
        <div class="header-with-date">
            <h1><i class="fas fa-calendar-alt me-2"></i>Quản lý Hành trình</h1>
            <a asp-area="Admin" asp-controller="Itenerary" asp-action="Add" class="btn btn-success">
                <i class="fas fa-plus me-1"></i>Thêm Hành trình
            </a>
        </div>
        @* Nhóm dữ liệu theo Tour *@
        @foreach (var group in Model.GroupBy(i => i.Tour?.Name_Tour))
        {
            <div class="group-title">@group.Key</div>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ngày thứ</th>
                        <th>Tiêu đề</th>
                        <th>Chi tiết</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in group.OrderBy(i => i.Day_Number))
                    {
                        <tr>
                            <td>@item.ID_Itinerary</td>
                            <td>@item.Day_Number</td>
                            <td>@item.Title</td>
                            <td>
                                @if (item.Details != null && item.Details.Any())
                                {
                                    <ul class="detail-list">
                                        @foreach (var d in item.Details)
                                        {
                                            <li>
                                                <strong>@d.Time:</strong> @d.Activities
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>Không có chi tiết</span>
                                }
                            </td>
                            <td>
                                <a asp-area="Admin" asp-controller="Itenerary" asp-action="Edit"
                                    asp-route-id="@item.ID_Itinerary" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="Itenerary" asp-action="Delete"
                                    asp-route-id="@item.ID_Itinerary" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</body>

</html>

       
       