@model LAPTRINHWEB.Models.Itinerary
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Chỉnh sửa Hành trình";
    var tours = ViewData["TourList"] as SelectList;
    var locations = ViewData["LocationList"] as MultiSelectList;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f6f9;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background-color: #343a40;
            color: white;
            padding: 15px 0;
            height: 100vh;
            position: fixed;
        }

        .sidebar-item {
            padding: 12px 20px;
            display: flex;
            align-items: center;
            transition: all 0.3s;
            cursor: pointer;
        }

        .sidebar-item:hover {
            background-color: #4b545c;
        }

        .sidebar-item.active {
            background-color: #007bff;
        }

        .sidebar-item i {
            margin-right: 10px;
        }

        .content {
            flex: 1;
            padding: 20px;
            margin-left: 250px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }

        .card {
            background-color: #fff;
            border-radius: 5px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .form-control {
            width: 100%;
            padding: 8px;
            border: 1px solid #ced4da;
            border-radius: 4px;
        }

        .btn {
            padding: 8px 15px;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
            color: white;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }

        .btn:hover {
            background-color: #0069d9;
        }

        .btn-secondary {
            background-color: #6c757d;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -15px;
            margin-left: -15px;
        }

        .col-md-6 {
            flex: 0 0 50%;
            max-width: 50%;
            padding: 0 15px;
        }

        /* Style phần chi tiết */
        .detail-container {
            margin-top: 20px;
        }

        .detail-header {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .detail-row {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

        .detail-row input {
            flex: 1;
            padding: 8px;
            border: 1px solid #ced4da;
            border-radius: 4px;
        }

        .btn-remove-detail {
            background-color: #dc3545;
            border: none;
            color: white;
            padding: 8px 10px;
            border-radius: 4px;
            cursor: pointer;
        }

        .btn-add-detail {
            background-color: #28a745;
            border: none;
            color: white;
            padding: 8px 15px;
            border-radius: 4px;
            cursor: pointer;
            margin-top: 10px;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <div class="sidebar-item">
            <i class="fas fa-chart-line"></i>
            <span>Dashboard</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-map-marked-alt"></i>
            <span>Quản lý Tour</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-users"></i>
            <span>Quản lý Người dùng</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-bus"></i>
            <span>Quản lý Phương tiện</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-hotel"></i>
            <span>Quản lý Nơi ở</span>
        </div>
        <div class="sidebar-item active">
            <i class="fas fa-calendar-alt"></i>
            <span>Quản lý Lịch trình</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-route"></i>
            <span>Quản lý Hành trình</span>
        </div>
        <div class="sidebar-item">
            <i class="fas fa-user-tie"></i>
            <span>Quản lý HDV</span>
        </div>
    </div>

    <div class="content">
        <div class="header">
            <h2>@ViewData["Title"]</h2>
            <a href='@Url.Action("Index", "Itenerary", new { area = "Admin" })' class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>

        <div class="card">
            <form asp-area="Admin" asp-controller="Itenerary" asp-action="Edit" method="post" id="editIteneraryForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ID_Itinerary" />
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ID_Tour">Tour:</label>
                            <select asp-for="ID_Tour" asp-items="tours" class="form-control"></select>
                        </div>
                        <div class="form-group">
                            <label asp-for="Day_Number">Ngày thứ:</label>
                            <input asp-for="Day_Number" type="number" min="1" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Title">Tiêu đề:</label>
                            <input asp-for="Title" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Chọn địa điểm:</label>
                            <select name="SelectedLocations" asp-items="locations" class="form-control"
                                multiple></select>
                        </div>
                    </div>
                </div>

                <!-- Phần chi tiết lịch trình -->
                <div class="detail-container">
                    <div class="detail-header">Chi tiết lịch trình</div>
                    <div id="detailsContainer">
                        @if (Model.Details != null && Model.Details.Any())
                        {
                            for (int i = 0; i < Model.Details.Count; i++)
                            {
                                <div class="detail-row">
                                    <input type="hidden" name="Details[@i].ID_Detail"
                                        value="@Model.Details.ElementAt(i).ID_Detail" />
                                    <input type="text" name="Details[@i].Time" value="@Model.Details.ElementAt(i).Time"
                                        placeholder="Time" required />
                                    <input type="text" name="Details[@i].Activities"
                                        value="@Model.Details.ElementAt(i).Activities" placeholder="Activities" required />
                                    <button type="button" class="btn-remove-detail" onclick="removeDetail(this)">X</button>
                                </div>
                            }
                        }
                    </div>
                    <button type="button" class="btn-add-detail" onclick="addDetail()">Thêm chi tiết</button>
                </div>

                <div class="form-group" style="margin-top: 20px;">
                    <button type="submit" class="btn">Cập nhật hành trình</button>
                    <a href='@Url.Action("Index", "Itenerary", new { area = "Admin" })' class="btn btn-secondary"
                        style="margin-left: 10px;">Hủy</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function removeDetail(btn) {
            btn.parentElement.remove();
        }
        function addDetail() {
            var container = document.getElementById('detailsContainer');
            var index = container.children.length;
            var div = document.createElement('div');
            div.className = "detail-row";
            div.innerHTML = '<input type="text" name="Details[' + index + '].Time" placeholder="Time" required/>' +
                '<input type="text" name="Details[' + index + '].Activities" placeholder="Activities" required/>' +
                '<button type="button" class="btn-remove-detail" onclick="removeDetail(this)">X</button>';
            container.appendChild(div);
        }
    </script>
</body>

</html>