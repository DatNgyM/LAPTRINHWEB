@model LAPTRINHWEB.Models.Tour

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Name_Tour - EasyTrips</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/tour-detail.css">
    <link rel="stylesheet" href="/css/tour-tabs.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
    <!-- Header -->
    <header>
        <div class="logo">
            <h1>EasyTrips</h1>
        </div>
        <nav>
            <ul>
                <li><a asp-controller="Home" asp-action="HomePage">Trang chủ</a></li>
                <li><a asp-controller="Tour" asp-action="ListTour" class="active">Tour</a></li>
                <li><a href="#">Điểm đến</a></li>
                <li><a href="#">Đánh giá</a></li>
                <li><a href="#">Liên hệ</a></li>
            </ul>
        </nav>
        <div class="search-icon">
            <i class="fas fa-search"></i>
        </div>
    </header>

    <!-- Tour Detail Section -->
    <section class="tour-detail">
        <div class="container">
            <div class="tour-gallery">
                <div class="main-image">
                    <img src="@Model.MainImageUrl" alt="@Model.Name_Tour" onerror="this.src='/img/default-tour.jpg'">
                </div>
                @if (Model.TourImages != null && Model.TourImages.Any())
                {
                    <div class="thumbnails">
                        @foreach (var image in Model.TourImages.Take(4))
                        {
                            <img src="@image.Image_URL" alt="@image.Caption" onclick="changeMainImage(this.src)">
                        }
                    </div>
                }
            </div>

            <div class="tour-content">
                <div class="tour-info">
                    <h1>@Model.Name_Tour</h1>
                    <div class="tour-rating">
                        <span class="stars">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star-half-alt"></i>
                        </span>
                        <span class="rating-count">@ViewBag.AverageRating/5</span>
                        <span class="review-count">(@ViewBag.TotalReviews đánh giá)</span>
                    </div>

                    <div class="tour-meta">
                        <div class="meta-item">
                            <i class="fas fa-clock"></i>
                            <span>@Model.DurationText</span>
                        </div>
                        <div class="meta-item">
                            <i class="fas fa-users"></i>
                            <span>Tối đa @Model.Max_Capacity người</span>
                        </div>
                        <div class="meta-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>@Model.Start_Location → @Model.End_Location</span>
                        </div>
                    </div>

                    <div class="tour-description">
                        <p>@Model.Description</p>
                    </div>

                    <div class="tour-price">
                        <div class="price-box">
                            @if (ViewBag.HasDiscount)
                            {
                                <span class="current-price">@Model.FinalPrice.ToString("N0") VND</span>
                                <span class="original-price">@Model.Price.ToString("N0") VND</span>
                                <span class="discount-amount">Tiết kiệm @Model.Discount.Value.ToString("N0") VND</span>
                            }
                            else
                            {
                                <span class="current-price">@Model.Price.ToString("N0") VND</span>
                            }
                        </div>
                        <p class="price-note">Giá/người</p>
                    </div>

                    <div class="booking-actions">
                        <button class="btn-book-now" onclick="showBookingInfo()">Đặt ngay</button>
                        <button class="btn-add-wishlist"><i class="far fa-heart"></i> Lưu</button>
                        <button class="btn-share"><i class="fas fa-share-alt"></i> Chia sẻ</button>
                    </div>
                </div>
            </div>

            <!-- Tour Tabs -->
            <div class="tour-tabs">
                <div class="tab-nav">
                    <button class="tab-btn active" data-tab="overview">Tổng quan</button>
                    <button class="tab-btn" data-tab="itinerary">Lịch trình</button>
                    <button class="tab-btn" data-tab="includes">Bao gồm</button>
                </div>
                
                <div class="tab-content">
                    <div class="tab-pane active" id="overview">
                        <h3>Tổng quan về tour</h3>
                        <p>@Model.Description</p>
                        
                        @if (Model.TourAccommodations != null && Model.TourAccommodations.Any())
                        {
                            <h4>Khách sạn</h4>
                            <ul>
                                @foreach (var accommodation in Model.TourAccommodations)
                                {
                                    <li>@accommodation.Accommodation?.Name (@accommodation.Accommodation?.Star_Rating sao) - @accommodation.Nights đêm</li>
                                }
                            </ul>
                        }

                        @if (Model.TourTransports != null && Model.TourTransports.Any())
                        {
                            <h4>Phương tiện di chuyển</h4>
                            <ul>
                                @foreach (var transport in Model.TourTransports)
                                {
                                    <li>@transport.Transportation?.Name - @transport.From_Location đến @transport.To_Location</li>
                                }
                            </ul>
                        }
                    </div>
                    
                    <div class="tab-pane" id="itinerary">
                        <h3>Lịch trình tour</h3>
                        @if (Model.Itineraries != null && Model.Itineraries.Any())
                        {
                            @foreach (var itinerary in Model.Itineraries.OrderBy(i => i.Day_Number))
                            {
                                <div class="day-itinerary">
                                    <h4>@itinerary.Title</h4>
                                    
                                </div>
                            }
                        }
                        @* else
                        {
                            <p>Lịch trình chi tiết sẽ được cập nhật sớm.</p>
                        } *@
                    </div>
                    
                    <div class="tab-pane" id="includes">
                        <h3>Dịch vụ bao gồm</h3>
                        <ul class="includes-list">
                            <li><i class="fas fa-check"></i> Xe du lịch đời mới máy lạnh</li>
                            <li><i class="fas fa-check"></i> Khách sạn theo tiêu chuẩn</li>
                            <li><i class="fas fa-check"></i> Các bữa ăn theo chương trình</li>
                            <li><i class="fas fa-check"></i> Vé tham quan</li>
                            <li><i class="fas fa-check"></i> Hướng dẫn viên chuyên nghiệp</li>
                            <li><i class="fas fa-check"></i> Bảo hiểm du lịch</li>
                        </ul>
                        
                        <h3>Dịch vụ không bao gồm</h3>
                        <ul class="not-includes-list">
                            <li><i class="fas fa-times"></i> Chi phí cá nhân</li>
                            <li><i class="fas fa-times"></i> Tiền tip</li>
                            <li><i class="fas fa-times"></i> Thuế VAT</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Back to List -->
    <div class="back-to-list">
        <a asp-action="ListTour" class="btn-back">← Quay lại danh sách tour</a>
    </div>

    <!-- Footer -->
    <footer>
        <div class="copyright">
            <p>&copy; 2025 EasyTrips. All rights reserved.</p>
        </div>
    </footer>

    <script>
        function changeMainImage(src) {
            document.querySelector('.main-image img').src = src;
        }

        function showBookingInfo() {
            alert('Chức năng đặt tour sẽ được phát triển trong phiên bản tiếp theo.');
        }

        // Tab functionality
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
                
                this.classList.add('active');
                document.getElementById(this.dataset.tab).classList.add('active');
            });
        });

        document.addEventListener('DOMContentLoaded', function() {
            console.log('Tour detail page loaded');
        });
    </script>
</body>
</html>