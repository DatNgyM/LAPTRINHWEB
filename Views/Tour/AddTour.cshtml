@model LAPTRINHWEB.Models.Tour

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thêm Tour Mới - EasyTrips</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .form-section {
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 2rem;
        }

        .section-header {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            padding: 1rem;
            border-radius: 10px 10px 0 0;
        }

        .dragover {
            border-color: #007bff !important;
            background-color: #e3f2fd !important;
        }

        .preview-image {
            position: relative;
            display: inline-block;
            margin: 0.5rem;
        }

        .remove-image {
            position: absolute;
            top: 5px;
            right: 5px;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">
                <i class="fas fa-plane"></i> EasyTrips
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="HomePage">
                            <i class="fas fa-home"></i> Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Tour" asp-action="ListTour">
                            <i class="fas fa-list"></i> Tour
                        </a>
                    </li>
                </ul>
                <div class="d-flex">
                    <a asp-controller="Tour" asp-action="ListTour" class="btn btn-outline-light">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container my-5">
        <!-- Page Header -->
        <div class="text-center mb-5">
            <div class="bg-white p-4 rounded-3 shadow-sm">
                <h1 class="display-5 text-primary">
                    <i class="fas fa-plus-circle"></i> Thêm Tour Mới
                </h1>
                <p class="lead text-muted">Tạo tour du lịch mới để phục vụ khách hàng</p>
            </div>
        </div>

        <!-- Form -->
        <form asp-action="AddTour" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Basic Information -->
            <div class="form-section">
                <div class="section-header">
                    <h3 class="mb-0">
                        <i class="fas fa-info-circle"></i> Thông tin cơ bản
                    </h3>
                </div>
                <div class="p-4">
                    <!-- Tour Name -->
                    <div class="mb-3">
                        <label asp-for="Name_Tour" class="form-label fw-bold">
                            <i class="fas fa-map-signs text-primary"></i> Tên Tour <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name_Tour" class="form-control form-control-lg"
                            placeholder="Nhập tên tour du lịch..." />
                        <span asp-validation-for="Name_Tour" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">
                            <i class="fas fa-align-left text-primary"></i> Mô tả Tour
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="5"
                            placeholder="Mô tả chi tiết về tour, điểm nổi bật, trải nghiệm..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Duration, Capacity, Status -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Duration" class="form-label fw-bold">
                                <i class="fas fa-clock text-primary"></i> Thời gian (ngày) <span
                                    class="text-danger">*</span>
                            </label>
                            <input asp-for="Duration" type="number" min="1" max="30" class="form-control"
                                placeholder="3" />
                            <span asp-validation-for="Duration" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Max_Capacity" class="form-label fw-bold">
                                <i class="fas fa-users text-primary"></i> Sức chứa tối đa <span
                                    class="text-danger">*</span>
                            </label>
                            <input asp-for="Max_Capacity" type="number" min="1" max="100" class="form-control"
                                placeholder="20" />
                            <span asp-validation-for="Max_Capacity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Status" class="form-label fw-bold">
                                <i class="fas fa-toggle-on text-primary"></i> Trạng thái
                            </label>
                            <select asp-for="Status" class="form-select">
                                <option value="0">Hoạt động</option>
                                <option value="1">Tạm dừng</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Location Information -->
            <div class="form-section">
                <div class="section-header">
                    <h3 class="mb-0">
                        <i class="fas fa-map-marker-alt"></i> Thông tin địa điểm
                    </h3>
                </div>
                <div class="p-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Start_Location" class="form-label fw-bold">
                                <i class="fas fa-play-circle text-success"></i> Điểm khởi hành <span
                                    class="text-danger">*</span>
                            </label>
                            <input asp-for="Start_Location" class="form-control" placeholder="Hà Nội, TP.HCM..." />
                            <span asp-validation-for="Start_Location" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="End_Location" class="form-label fw-bold">
                                <i class="fas fa-stop-circle text-danger"></i> Điểm kết thúc <span
                                    class="text-danger">*</span>
                            </label>
                            <input asp-for="End_Location" class="form-control" placeholder="Đà Nẵng, Nha Trang..." />
                            <span asp-validation-for="End_Location" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pricing Information -->
            <div class="form-section">
                <div class="section-header">
                    <h3 class="mb-0">
                        <i class="fas fa-money-bill-wave"></i> Thông tin giá cả
                    </h3>
                </div>
                <div class="p-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label fw-bold">
                                <i class="fas fa-tag text-warning"></i> Giá gốc (VND) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="Price" type="number" min="0" step="1000" class="form-control"
                                    placeholder="2000000" id="price-input" />
                                <span class="input-group-text">VND</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                            <div class="form-text">Nhập giá bằng VND (ví dụ: 2000000 = 2 triệu VND)</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Discount" class="form-label fw-bold">
                                <i class="fas fa-percent text-info"></i> Giảm giá (VND)
                            </label>
                            <div class="input-group">
                                <input asp-for="Discount" type="number" min="0" step="1000" class="form-control"
                                    placeholder="200000" id="discount-input" />
                                <span class="input-group-text">VND</span>
                            </div>
                            <span asp-validation-for="Discount" class="text-danger small"></span>
                            <div class="form-text">Số tiền giảm giá (không bắt buộc)</div>
                        </div>
                    </div>

                    <!-- Price Preview -->
                    <div class="alert alert-info d-flex align-items-center" role="alert">
                        <i class="fas fa-calculator me-2"></i>
                        <div>
                            <strong>Giá cuối cùng: </strong>
                            <span id="final-price" class="badge bg-success fs-6">0 VND</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Images Section -->
            <div class="form-section">
                <div class="section-header">
                    <h3 class="mb-0">
                        <i class="fas fa-images"></i> Hình ảnh Tour
                    </h3>
                </div>
                <div class="p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="fas fa-camera text-primary"></i> Chọn hình ảnh
                        </label>

                        <!-- File Input -->
                        <input type="file" id="tour-images" name="TourImages" multiple accept="image/*"
                            class="form-control" />

                        <!-- Upload Area -->
                        <div id="upload-area"
                            class="border border-2 border-dashed border-secondary rounded p-4 text-center mt-3">
                            <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
                            <p class="mb-2">Kéo thả hoặc click để chọn hình ảnh</p>
                            <small class="text-muted">Hỗ trợ: JPG, PNG, GIF (tối đa 5MB mỗi file)</small>
                        </div>

                        <!-- Image Preview -->
                        <div id="image-preview" class="mt-3"></div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="form-section">
                <div class="p-4 bg-light">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <button type="submit" class="btn btn-primary btn-lg me-md-2">
                            <i class="fas fa-save"></i> Lưu Tour
                        </button>
                        <button type="button" class="btn btn-secondary btn-lg me-md-2" onclick="resetForm()">
                            <i class="fas fa-undo"></i> Đặt lại
                        </button>
                        <a asp-action="ListTour" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-times"></i> Hủy bỏ
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            // Price calculation
            function calculateFinalPrice() {
                var price = parseFloat($('#Price').val()) || 0;
                var discount = parseFloat($('#Discount').val()) || 0;
                var finalPrice = Math.max(0, price - discount);

                $('#final-price').text(finalPrice.toLocaleString('vi-VN') + ' VND');

                if (discount > 0) {
                    $('#final-price').removeClass('bg-success').addClass('bg-warning');
                } else {
                    $('#final-price').removeClass('bg-warning').addClass('bg-success');
                }
            }

            $('#Price, #Discount').on('input', calculateFinalPrice);
            calculateFinalPrice();

            // Image upload handling
            $('#tour-images').on('change', function () {
                handleFiles(this.files);
            });

            // Drag and drop
            $('#upload-area').on('click', function () {
                $('#tour-images').click();
            });

            $('#upload-area').on('dragover', function (e) {
                e.preventDefault();
                $(this).addClass('dragover');
            });

            $('#upload-area').on('dragleave', function (e) {
                e.preventDefault();
                $(this).removeClass('dragover');
            });

            $('#upload-area').on('drop', function (e) {
                e.preventDefault();
                $(this).removeClass('dragover');
                var files = e.originalEvent.dataTransfer.files;
                handleFiles(files);
            });

            function handleFiles(files) {
                var preview = $('#image-preview');
                preview.empty();

                if (files.length > 0) {
                    for (var i = 0; i < files.length; i++) {
                        var file = files[i];
                        if (file.type.startsWith('image/')) {
                            var reader = new FileReader();
                            reader.onload = function (e) {
                                var imgHtml = `
                                    <div class="preview-image d-inline-block m-2">
                                        <div class="position-relative">
                                            <img src="${e.target.result}" class="img-thumbnail" style="width: 150px; height: 150px; object-fit: cover;">
                                            <button type="button" class="btn btn-danger btn-sm remove-image position-absolute top-0 end-0" onclick="removeImage(this)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </div>
                                `;
                                preview.append(imgHtml);
                            };
                            reader.readAsDataURL(file);
                        }
                    }
                }
            }

            // Form validation
            $('form').on('submit', function (e) {
                var isValid = true;
                var requiredFields = [
                    { field: '#Name_Tour', message: 'Tên tour là bắt buộc' },
                    { field: '#Duration', message: 'Thời gian tour là bắt buộc' },
                    { field: '#Start_Location', message: 'Điểm khởi hành là bắt buộc' },
                    { field: '#End_Location', message: 'Điểm kết thúc là bắt buộc' },
                    { field: '#Price', message: 'Giá tour là bắt buộc' },
                    { field: '#Max_Capacity', message: 'Sức chứa tối đa là bắt buộc' }
                ];

                // Remove previous validation styles
                $('.is-invalid').removeClass('is-invalid');
                $('.invalid-feedback').remove();

                requiredFields.forEach(function (item) {
                    var $field = $(item.field);
                    var value = $field.val().trim();

                    if (!value || (item.field === '#Duration' && parseInt(value) < 1) ||
                        (item.field === '#Max_Capacity' && parseInt(value) < 1) ||
                        (item.field === '#Price' && parseFloat(value) <= 0)) {

                        isValid = false;
                        $field.addClass('is-invalid');
                        $field.after(`<div class="invalid-feedback">${item.message}</div>`);
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    // Scroll to first error
                    $('html, body').animate({
                        scrollTop: $('.is-invalid').first().offset().top - 100
                    }, 500);

                    // Show toast notification
                    showToast('Vui lòng điền đầy đủ thông tin bắt buộc!', 'error');
                }
            });
        });

        function removeImage(button) {
            $(button).closest('.preview-image').remove();
        }

        function resetForm() {
            if (confirm('Bạn có chắc chắn muốn đặt lại form? Tất cả dữ liệu sẽ bị xóa.')) {
                $('form')[0].reset();
                $('#image-preview').empty();
                $('#final-price').text('0 VND');
                $('.is-invalid').removeClass('is-invalid');
                $('.invalid-feedback').remove();
            }
        }

        function showToast(message, type = 'info') {
            var toastClass = type === 'error' ? 'bg-danger' : 'bg-success';
            var toastHtml = `
                <div class="toast align-items-center text-white ${toastClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            // Create toast container if it doesn't exist
            if ($('#toast-container').length === 0) {
                $('body').append('<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
            }

            var $toast = $(toastHtml);
            $('#toast-container').append($toast);

            var toast = new bootstrap.Toast($toast[0]);
            toast.show();

            // Remove toast after it's hidden
            $toast.on('hidden.bs.toast', function () {
                $(this).remove();
            });
        }
    </script>
</body>

</html>