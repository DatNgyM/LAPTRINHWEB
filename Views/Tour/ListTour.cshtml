@model List<LAPTRINHWEB.Models.Tour>
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách Tour - EasyTrips</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/tour-listing.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Bootstrap CSS for better styling -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        .admin-actions {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.7);
            padding: 8px;
            border-radius: 8px;
            display: flex;
            gap: 5px;
        }

        .admin-btn {
            padding: 6px 12px;
            border: none;
            border-radius: 5px;
            color: white;
            text-decoration: none;
            font-size: 12px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .admin-btn:hover {
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }

        .btn-edit {
            background: #ffc107;
        }

        .btn-edit:hover {
            background: #e0a800;
        }

        .btn-delete {
            background: #dc3545;
        }

        .btn-delete:hover {
            background: #c82333;
        }

        .tour-item {
            position: relative;
        }

        .add-tour-section {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
        }

        .btn-add-tour {
            background: #28a745;
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-add-tour:hover {
            background: #218838;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
            color: white;
            text-decoration: none;
        }

        .admin-toolbar {
            background: #f8f9fa;
            padding: 1rem 0;
            border-bottom: 2px solid #dee2e6;
            margin-bottom: 2rem;
        }

        .bulk-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .select-all-checkbox {
            margin-right: 0.5rem;
        }

        .tour-checkbox {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 10;
        }

        .bulk-action-btn {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            color: white;
            cursor: pointer;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s ease;
        }

        .bulk-delete-btn {
            background: #dc3545;
        }

        .bulk-delete-btn:hover {
            background: #c82333;
        }

        .bulk-status-btn {
            background: #6c757d;
        }

        .bulk-status-btn:hover {
            background: #5a6268;
        }

        .tour-status {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: bold;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }


        .bulk-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .bulk-actions>div {
            margin-bottom: 10px;
        }
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header>
        <div class="logo">
            <h1>EasyTrips</h1>
        </div>
        <nav>
            <ul>
                <li><a asp-controller="Home" asp-action="HomePage">Home</a></li>
                <li><a asp-controller="Tour" asp-action="ListTour" class="active">Tour</a></li>
                <li><a href="#">Destination</a></li>
                <li><a href="#">Evaluate</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
        </nav>
        <div class="search-icon">
            <i class="fas fa-search"></i>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h2>Danh sách tour</h2>
            <h3>Khám phá vẻ đẹp Việt Nam</h3>
        </div>
    </section>

    <!-- Add Tour Section -->
    <section class="add-tour-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h3 class="mb-2">
                        <i class="fas fa-cogs"></i> Quản lý Tour Du lịch
                    </h3>
                    <p class="mb-0">Thêm, chỉnh sửa hoặc xóa các tour du lịch của bạn</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-action="AddTour" class="btn-add-tour">
                        <i class="fas fa-plus-circle"></i>
                        Thêm Tour Mới
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Admin Toolbar -->
    <section class="admin-toolbar">
        <div class="container">
            <div class="bulk-actions">
                <div class="d-flex align-items-center">
                    <input type="checkbox" id="select-all" class="form-check-input select-all-checkbox">
                    <label for="select-all" class="form-check-label">Chọn tất cả</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="bulk-action-btn bulk-delete-btn" id="bulk-delete" disabled>
                        <i class="fas fa-trash-alt"></i>
                        Xóa đã chọn
                    </button>

                    <button type="button" class="bulk-action-btn bulk-status-btn" id="bulk-activate" disabled>
                        <i class="fas fa-toggle-on"></i>
                        Kích hoạt
                    </button>

                    <button type="button" class="bulk-action-btn bulk-status-btn" id="bulk-deactivate" disabled>
                        <i class="fas fa-toggle-off"></i>
                        Tạm dừng
                    </button>
                </div>

                <div class="ms-auto">
                    <span class="text-muted">
                        <span id="selected-count">0</span> tour đã chọn
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- Tour Listing Section -->
    <section class="tour-listing">
        <div class="container">
            <div class="tour-listing-header">
                <h2>Tất cả Tour Du lịch</h2>
                <div class="tour-count">
                    <span>Hiển thị <strong>@(Model?.Count ?? 0)</strong> tour</span>
                </div>
            </div>

            <div class="tour-listing-content">
                <div class="tour-list">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var tour in Model)
                        {
                            <div class="tour-item" data-tour-id="@tour.ID_Tour">
                                <!-- Tour Checkbox -->
                                <input type="checkbox" class="form-check-input tour-checkbox" value="@tour.ID_Tour">

                                <!-- Tour Status -->
                                <div
                                    class="tour-status @(tour.Status == LAPTRINHWEB.Models.TourStatus.Active ? "status-active" : "status-inactive")">
                                    @(tour.Status == LAPTRINHWEB.Models.TourStatus.Active ? "Hoạt động" : "Tạm dừng")
                                </div>

                                <!-- Admin Actions -->
                                <div class="admin-actions">
                                    <a asp-action="Edit" asp-route-id="@tour.ID_Tour" class="admin-btn btn-edit"
                                        title="Chỉnh sửa">
                                        <i class="fas fa-edit"></i>
                                        <span class="d-none d-sm-inline">Sửa</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@tour.ID_Tour" class="admin-btn btn-delete"
                                        title="Xóa">
                                        <i class="fas fa-trash-alt"></i>
                                        <span class="d-none d-sm-inline">Xóa</span>
                                    </a>
                                </div>

                                <div class="tour-image">
                                    <img src="@tour.MainImageUrl" alt="@tour.Name_Tour"
                                        onerror="this.src='/img/default-tour.jpg'">
                                    @if (tour.Discount.HasValue && tour.Discount > 0)
                                    {
                                        <span class="tour-badge discount-badge">-@tour.Discount.Value.ToString("N0") VND</span>
                                    }
                                    else
                                    {
                                        <span class="tour-badge">Bestseller</span>
                                    }
                                </div>
                                <div class="tour-content">
                                    <h3><a asp-action="Detail" asp-route-id="@tour.ID_Tour">@tour.Name_Tour</a></h3>
                                    <div class="tour-rating">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <span>(@(tour.Bookings?.Count ?? 0) đánh giá)</span>
                                    </div>
                                    <div class="tour-meta">
                                        <span><i class="fas fa-clock"></i> @tour.DurationText</span>
                                        <span><i class="fas fa-users"></i> Tối đa @tour.Max_Capacity người</span>
                                        <span><i class="fas fa-map-marker-alt"></i> @tour.Start_Location -
                                            @tour.End_Location</span>
                                    </div>
                                    <div class="tour-description">
                                        <p>@(tour.Description?.Length > 150 ? tour.Description.Substring(0, 150) + "..." :
                                                                                tour.Description)</p>
                            </div>
                            <div class="tour-price">
                                <div class="price">
                                    <span class="current">@tour.FinalPrice.ToString("N0") VND</span>
                                    @if (tour.Discount.HasValue && tour.Discount > 0)
                                            {
                                                <span class="original">@tour.Price.ToString("N0") VND</span>
                                            }
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Detail" asp-route-id="@tour.ID_Tour" class="btn-view-details">Xem chi
                                                tiết</a>
                                            <a asp-action="Edit" asp-route-id="@tour.ID_Tour" class="btn btn-warning btn-sm">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-tours-found">
                            <div class="text-center py-5">
                                <i class="fas fa-map-marked-alt fa-4x text-muted mb-3"></i>
                                <h3>Hiện tại chưa có tour nào</h3>
                                <p class="text-muted mb-4">Hãy thêm tour đầu tiên để bắt đầu kinh doanh du lịch của bạn.</p>
                                <div class="d-flex gap-3 justify-content-center">
                                    <a asp-action="AddTour" class="btn-add-tour">
                                        <i class="fas fa-plus-circle"></i>
                                        Thêm Tour Đầu Tiên
                                    </a>
                                    <a asp-controller="Home" asp-action="HomePage" class="btn-back-home">Về trang chủ</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-column">
                <h3>EasyTrips</h3>
                <p>Khám phá vẻ đẹp Việt Nam cùng chúng tôi</p>
            </div>
        </div>
        <div class="copyright">
            <p>&copy; 2025 EasyTrips. All rights reserved.</p>
        </div>
    </footer>

    <!-- Bootstrap Modal for Bulk Actions -->
    <div class="modal fade" id="confirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Xác nhận thao tác</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="modal-message"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger" id="confirm-action">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="liveToast" class="toast" role="alert">
            <div class="toast-header">
                <strong class="me-auto">Thông báo</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="toast-message"></div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            // Select all functionality
            $('#select-all').on('change', function () {
                $('.tour-checkbox').prop('checked', this.checked);
                updateBulkActions();
            });

            // Individual checkbox functionality
            $('.tour-checkbox').on('change', function () {
                updateBulkActions();

                // Update select all checkbox
                var totalCheckboxes = $('.tour-checkbox').length;
                var checkedCheckboxes = $('.tour-checkbox:checked').length;
                $('#select-all').prop('checked', totalCheckboxes === checkedCheckboxes);
            });

            // Update bulk action buttons and counter
            function updateBulkActions() {
                var selectedCount = $('.tour-checkbox:checked').length;
                $('#selected-count').text(selectedCount);

                var bulkButtons = $('#bulk-delete, #bulk-activate, #bulk-deactivate');
                if (selectedCount > 0) {
                    bulkButtons.prop('disabled', false);
                } else {
                    bulkButtons.prop('disabled', true);
                }
            }

            // Bulk delete
            $('#bulk-delete').on('click', function () {
                var selectedIds = $('.tour-checkbox:checked').map(function () {
                    return $(this).val();
                }).get();

                if (selectedIds.length === 0) return;

                $('#modal-message').text(`Bạn có chắc chắn muốn xóa ${selectedIds.length} tour đã chọn? Hành động này không thể hoàn tác.`);
                $('#confirm-action').off('click').on('click', function () {
                    performBulkAction('delete', selectedIds);
                });

                new bootstrap.Modal(document.getElementById('confirmModal')).show();
            });

            // Bulk activate/deactivate
            $('#bulk-activate').on('click', function () {
                performBulkStatusChange('activate');
            });

            $('#bulk-deactivate').on('click', function () {
                performBulkStatusChange('deactivate');
            });

            function performBulkStatusChange(action) {
                var selectedIds = $('.tour-checkbox:checked').map(function () {
                    return $(this).val();
                }).get();

                if (selectedIds.length === 0) return;

                var actionText = action === 'activate' ? 'kích hoạt' : 'tạm dừng';
                $('#modal-message').text(`Bạn có muốn ${actionText} ${selectedIds.length} tour đã chọn?`);
                $('#confirm-action').off('click').on('click', function () {
                    performBulkAction(action, selectedIds);
                });

                new bootstrap.Modal(document.getElementById('confirmModal')).show();
            }

            function performBulkAction(action, ids) {
                // Close modal
                bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide();

                // Show loading state
                showToast('Đang xử lý...', 'info');

                // AJAX call to server
                $.ajax({
                    url: '@Url.Action("BulkAction", "Tour")',
                    type: 'POST',
                    data: {
                        action: action,
                        tourIds: ids
                    },
                    success: function (response) {
                        if (response.success) {
                            showToast(response.message, 'success');
                            // Reload page after 1 second
                            setTimeout(function () {
                                location.reload();
                            }, 1000);
                        } else {
                            showToast(response.message || 'Có lỗi xảy ra', 'error');
                        }
                    },
                    error: function () {
                        showToast('Có lỗi xảy ra khi thực hiện thao tác', 'error');
                    }
                });
            }

            function showToast(message, type) {
                var toastEl = document.getElementById('liveToast');
                var toast = new bootstrap.Toast(toastEl);

                $('#toast-message').text(message);

                // Change toast color based on type
                toastEl.className = 'toast';
                if (type === 'success') {
                    toastEl.classList.add('bg-success', 'text-white');
                } else if (type === 'error') {
                    toastEl.classList.add('bg-danger', 'text-white');
                } else {
                    toastEl.classList.add('bg-info', 'text-white');
                }

                toast.show();
            }

            // Show success/error messages from TempData
            @if (TempData["SuccessMessage"] != null)
                {
                    <text>
                        showToast('@TempData["SuccessMessage"]', 'success');
                    </text>
            }

                @if (TempData["ErrorMessage"] != null)
                {
                    <text>
                        showToast('@TempData["ErrorMessage"]', 'error');
                    </text>
            }

                // Initialize page
                updateBulkActions();
        });
    </script>
</body>

</html>