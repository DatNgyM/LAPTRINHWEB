@model List<LAPTRINHWEB.Models.Tour>
@{
    ViewData["Title"] = "Danh sách Tour";
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách Tour - EasyTrips</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/tour-listing.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <!-- Header -->
    <header>
        <div class="logo">
            <h1>EasyTrips</h1>
        </div>
        <nav>
            <ul>
                <li><a asp-controller="Home" asp-action="HomePage">Home</a></li>
                <li><a asp-controller="Tour" asp-action="ListTour" class="active">Tour</a></li>
                <li><a href="#">Destination</a></li>
                <li><a href="#">Evaluate</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
        </nav>
        
        <div class="header-right">
            <div class="search-icon">
                <i class="fas fa-search"></i>
            </div>
            
            <!-- Authentication Section -->
            <div class="auth-section">
                @if (User.Identity.IsAuthenticated)
                {
                    <!-- User is logged in -->
                    <div class="user-dropdown dropdown">
                        <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle"></i>
                            <span>@(User.Identity.Name)</span>
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="role-badge">Admin</span>
                            }
                            else if (User.IsInRole("TourGuide"))
                            {
                                <span class="role-badge">Guide</span>
                            }
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-user me-2"></i>Thông tin cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-history me-2"></i>Lịch sử đặt tour
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/Admin">
                                        <i class="fas fa-cog me-2"></i>Quản trị hệ thống
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("TourGuide"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/TourGuide">
                                        <i class="fas fa-route me-2"></i>Quản lý tour
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <!-- User is not logged in -->
                    <div class="auth-buttons">
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-login">
                            <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                        </a>
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-register">
                            <i class="fas fa-user-plus me-2"></i>Đăng ký
                        </a>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h2>Danh sách tour</h2>
            <h3>Khám phá vẻ đẹp Việt Nam</h3>
        </div>
    </section>

    <!-- Tour Listing Section -->
    <section class="tour-listing">
        <div class="container">
            <div class="tour-listing-header">
                <h2>Tất cả Tour Du lịch</h2>
                <div class="tour-count">
                    <span>Hiển thị <strong>@(Model?.Count ?? 0)</strong> tour</span>
                    @if (ViewBag.TotalTours != null)
                    {
                        <span class="text-muted ms-2">
                            (Trang @ViewBag.CurrentPage/@ViewBag.TotalPages - Tổng @ViewBag.TotalTours tour)
                        </span>
                    }
                </div>
            </div>

            <div class="tour-listing-content">
                <div class="tour-list">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var tour in Model)
                        {
                            <div class="tour-item">
                                <div class="tour-image">
                                    <img src="@tour.MainImageUrl" alt="@tour.Name_Tour"
                                        onerror="this.src='/img/default-tour.jpg'">
                                    @if (tour.Discount.HasValue && tour.Discount > 0)
                                    {
                                        <span class="tour-badge discount-badge">-@tour.Discount.Value.ToString("N0") VND</span>
                                    }
                                    else
                                    {
                                        <span class="tour-badge">Bestseller</span>
                                    }
                                </div>
                                <div class="tour-content">
                                    <h3><a asp-action="Detail" asp-route-id="@tour.ID_Tour">@tour.Name_Tour</a></h3>
                                    <div class="tour-rating">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <span>(@(tour.Bookings?.Count ?? 0) đánh giá)</span>
                                    </div>
                                    <div class="tour-meta">
                                        <span><i class="fas fa-clock"></i> @tour.DurationText</span>
                                        <span><i class="fas fa-users"></i> Tối đa @tour.Max_Capacity người</span>
                                        <span><i class="fas fa-map-marker-alt"></i> @tour.Start_Location - @tour.End_Location</span>
                                    </div>
                                    <div class="tour-description">
                                        <p>@(tour.Description?.Length > 150 ? tour.Description.Substring(0, 150) + "..." : tour.Description)</p>
                                    </div>
                                    <div class="tour-price">
                                        <div class="price">
                                            <span class="current">@tour.FinalPrice.ToString("N0") VND</span>
                                            @if (tour.Discount.HasValue && tour.Discount > 0)
                                            {
                                                <span class="original">@tour.Price.ToString("N0") VND</span>
                                            }
                                        </div>
                                        <div class="tour-actions">
                                            <a asp-action="Detail" asp-route-id="@tour.ID_Tour" class="btn-view-details">
                                                <i class="fas fa-eye me-2"></i>Xem chi tiết
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-tours-found">
                            <div class="text-center py-5">
                                <i class="fas fa-map-marked-alt fa-4x text-muted mb-3"></i>
                                <h3>Hiện tại chưa có tour nào</h3>
                                <p class="text-muted mb-4">Chúng tôi đang cập nhật thêm các tour du lịch hấp dẫn.</p>
                                <div class="d-flex gap-3 justify-content-center">
                                    <a asp-controller="Home" asp-action="HomePage" class="btn btn-primary">
                                        <i class="fas fa-home me-2"></i>Về trang chủ
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Tour pagination" class="mt-5">
                        <ul class="pagination justify-content-center">
                            <!-- Previous -->
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="ListTour" asp-route-page="@(ViewBag.CurrentPage - 1)">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                            }

                            <!-- Page numbers -->
                            @{
                                int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                                int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="ListTour" asp-route-page="1">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="ListTour" asp-route-page="@i">@i</a>
                                </li>
                            }

                            @if (endPage < ViewBag.TotalPages)
                            {
                                @if (endPage < ViewBag.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="ListTour" asp-route-page="@ViewBag.TotalPages">@ViewBag.TotalPages</a>
                                </li>
                            }

                            <!-- Next -->
                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="ListTour" asp-route-page="@(ViewBag.CurrentPage + 1)">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-column">
                <h3>EasyTrips</h3>
                <p>Khám phá vẻ đẹp Việt Nam cùng chúng tôi</p>
            </div>
            <div class="footer-column">
                <h3>Liên hệ</h3>
                <p>Email: info@easytrips.vn</p>
                <p>Hotline: 1900 1234</p>
            </div>
            <div class="footer-column">
                <h3>Theo dõi chúng tôi</h3>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
        </div>
        <div class="copyright">
            <p>&copy; 2025 EasyTrips. All rights reserved.</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* Authentication styles similar to homepage */
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-left: 20px;
        }
        
        .auth-buttons .btn {
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            display: inline-flex;
            align-items: center;
        }
        
        .btn-login {
            background: transparent;
            color: #333;
            border-color: #333;
        }
        
        .btn-login:hover {
            background: #333;
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }
        
        .btn-register {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        
        .btn-register:hover {
            background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }
        
        .user-dropdown {
            position: relative;
            display: inline-block;
        }
        
        .user-dropdown .dropdown-toggle {
            background: none;
            border: none;
            color: #333;
            padding: 8px 15px;
            border-radius: 25px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .user-dropdown .dropdown-toggle:hover {
            background: rgba(0,0,0,0.1);
        }
        
        .user-dropdown .dropdown-menu {
            min-width: 200px;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            border-radius: 10px;
        }
        
        .user-dropdown .dropdown-item {
            padding: 10px 20px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }
        
        .user-dropdown .dropdown-item:hover {
            background: #f8f9fa;
            color: #667eea;
        }
        
        .role-badge {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-size: 0.7rem;
            padding: 2px 8px;
            border-radius: 10px;
            margin-left: 5px;
        }
        
        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        /* Tour actions styling */
        .tour-actions {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .btn-view-details {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 10px 20px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
        }
        
        .btn-view-details:hover {
            background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        /* Pagination styling */
        .pagination .page-link {
            border-radius: 50px;
            margin: 0 2px;
            border: none;
            color: #667eea;
            padding: 8px 12px;
        }

        .pagination .page-item.active .page-link {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: transparent;
        }

        .pagination .page-link:hover {
            background-color: #f8f9fa;
            color: #667eea;
        }

        /* Tour listing improvements */
        .tour-listing-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .tour-count {
            color: #666;
            font-size: 1rem;
        }

        /* Responsive adjustments */
    </style>
</body>

</html>