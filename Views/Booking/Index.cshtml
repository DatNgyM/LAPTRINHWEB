@{
    var tour = ViewBag.Tour as LAPTRINHWEB.Models.Tour;
    ViewData["Title"] = "Đặt vé tour - EasyTrips";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/booking.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .booking-section {
            padding: 40px 0;
            background-color: #f4f6f9;
        }

        .booking-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .booking-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .booking-header h2 {
            font-size: 32px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }

        .booking-header p {
            font-size: 16px;
            color: #666;
        }

        .booking-content {
            display: flex;
            gap: 30px;
            flex-wrap: wrap;
        }

        .booking-form {
            flex: 1;
            min-width: 320px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            padding: 30px;
        }

        .tour-summary {
            width: 350px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            padding: 30px;
            position: sticky;
            top: 20px;
        }

        .form-section {
            margin-bottom: 25px;
        }

        .form-section h3 {
            font-size: 20px;
            margin-bottom: 15px;
            color: #333;
            border-bottom: 1px solid #eee;
            padding-bottom: 10px;
        }

        .form-floating {
            margin-bottom: 15px;
        }

        .booking-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }

        .btn-back {
            padding: 10px 20px;
            background-color: #6c757d;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s;
        }

        .btn-back:hover {
            background-color: #5a6268;
            color: white;
        }

        .btn-continue {
            padding: 10px 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .btn-continue:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .tour-image img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
        }

        .tour-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .tour-meta {
            color: #666;
            font-size: 14px;
            margin-bottom: 15px;
        }

        .tour-meta div {
            margin-bottom: 5px;
            display: flex;
            align-items: center;
        }

        .tour-meta i {
            width: 20px;
            margin-right: 8px;
            color: #667eea;
        }

        .price-summary {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .price-row.total {
            font-weight: bold;
            font-size: 18px;
            border-top: 1px solid #ddd;
            padding-top: 10px;
            margin-top: 10px;
        }

        @@media (max-width: 900px) {
            .booking-content {
                flex-direction: column;
            }

            .tour-summary {
                width: 100%;
                order: -1;
                position: static;
            }
        }
    </style>
</head>

<body>
    <!-- Header -->

    <!-- Booking Section -->
    <section class="booking-section">
        <div class="booking-container">
            <div class="booking-header">
                <h2>Thông tin đặt tour</h2>
                <p>Vui lòng điền đầy đủ thông tin để hoàn tất đặt vé tour của bạn.</p>
            </div>

            <div class="booking-content">
                <div class="booking-form">
                    <form id="bookingForm" asp-area="" asp-action="Index" asp-controller="Booking" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tourId" value="@tour?.ID_Tour" />

                        <!-- Thông tin cá nhân -->
                        <div class="form-section">
                            <h3><i class="fas fa-user"></i> Thông tin liên hệ</h3>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="fullName" name="fullName"
                                    placeholder="Họ và tên" required value="@ViewBag.FullName">
                                <label for="fullName">Họ và tên</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="email" class="form-control" id="email" name="email" placeholder="Email"
                                    required value="@ViewBag.Email">
                                <label for="email">Email</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="tel" class="form-control" id="phone" name="phone"
                                    placeholder="Số điện thoại" required value="@ViewBag.Phone">
                                <label for="phone">Số điện thoại</label>
                            </div>
                            <div class="form-floating">
                                <input type="text" class="form-control" id="address" name="address"
                                    placeholder="Địa chỉ" value="@ViewBag.Address">
                                <label for="address">Địa chỉ</label>
                            </div>
                        </div>

                        <!-- Chi tiết đặt tour -->
                        <div class="form-section">
                            <h3><i class="fas fa-calendar-alt"></i> Chi tiết đặt tour</h3>
                            <div class="form-floating mb-3">
                                <input type="date" class="form-control" id="departureDate" name="departureDate"
                                    value="@tour.DepartureDate.ToString("yyyy-MM-dd")" readonly required>
                                <label for="departureDate">Ngày khởi hành</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="number" class="form-control" id="quantity" name="quantity" min="1"
                                    value="1" required>
                                <label for="quantity">Số lượng người</label>
                            </div>
                        </div>

                        <div class="form-section">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="termsCheck" required>
                                <label class="form-check-label" for="termsCheck">
                                    Tôi đã đọc và đồng ý với <a href="#">điều khoản đặt tour</a> và <a href="#">chính
                                        sách hủy tour</a>
                                </label>
                            </div>
                        </div>

                        <div class="booking-actions">
                            <a href="/Tour/Detail/@tour?.ID_Tour" class="btn-back">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn-continue">
                                Tiếp tục thanh toán <i class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="tour-summary">
                    <h3>Thông tin tour</h3>
                    <div class="tour-info">
                        <div class="tour-image">
                            <img src="@tour?.MainImageUrl" alt="@tour?.Name_Tour" id="tourImage">
                        </div>
                        <h4 class="tour-title" id="tourName">@tour?.Name_Tour</h4>
                        <div class="tour-meta">
                            <div><i class="fas fa-calendar-alt"></i> <span id="tourDuration">@tour?.Duration</span>
                            </div>
                            <div><i class="fas fa-map-marker-alt"></i> <span
                                    id="tourLocation">@tour?.End_Location</span>
                            </div>
                            <div><i class="fas fa-users"></i> <span id="tourGroupSize">Tối đa
                                    @tour?.Max_Capacity người</span></div>
                        </div>
                    </div>
                    <div class="price-summary">
                        <h4>Giá tour</h4>
                        <div class="price-row">
                            <span>Giá mỗi người</span>
                            <span id="unitPrice">@((tour?.FinalPrice ?? 0).ToString("N0")) đ</span>
                        </div>
                        <div class="price-row total">
                            <span>Tổng tiền</span>
                            <span id="totalPrice">@((tour?.FinalPrice ?? 0).ToString("N0")) đ</span>
                        </div>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle"></i> Vui lòng kiểm tra kỹ thông tin đặt tour trước khi tiến hành
                        thanh toán.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-column">
                <h3>EasyTrips</h3>
                <p>Khám phá vẻ đẹp Việt Nam cùng chúng tôi</p>
            </div>
            <div class="footer-column">
                <h3>Liên hệ</h3>
                <p>Email: info@easytrips.vn</p>
                <p>Hotline: 1900 1234</p>
            </div>
            <div class="footer-column">
                <h3>Theo dõi chúng tôi</h3>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
        </div>
        <div class="copyright">
            <p>&copy; 2025 EasyTrips. All rights reserved.</p>
        </div>
    </footer>

    <!-- JavaScript Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Đặt ngày mặc định cho ngày khởi hành (3 ngày kể từ hiện tại)
        document.addEventListener('DOMContentLoaded', function () {
            const today = new Date();
            const defaultDate = new Date(today);
            defaultDate.setDate(today.getDate() + 3);
            const formattedDate = defaultDate.toISOString().split('T')[0];
            document.getElementById('departureDate').value = formattedDate;
            document.getElementById('departureDate').min = today.toISOString().split('T')[0];

            // Tính tổng tiền theo số lượng
            const quantityInput = document.getElementById('quantity');
            const unitPrice = parseInt(document.getElementById('unitPrice').innerText.replace(/\D/g, '')) || 0;
            const totalPriceSpan = document.getElementById('totalPrice');

            function updateTotal() {
                const qty = parseInt(quantityInput.value) || 1;
                const total = unitPrice * qty;
                totalPriceSpan.innerText = total.toLocaleString('vi-VN') + ' đ';
            }

            quantityInput.addEventListener('input', updateTotal);
            updateTotal();
        });
    </script>
</body>

</html>