@{
    Layout = null; // Không sử dụng layout mặc định
    var booking = ViewBag.BookingInfo;
    var tour = ViewBag.Tour as LAPTRINHWEB.Models.Tour;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Thanh toán - EasyTrips</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/payment.css">
    <link rel="stylesheet" href="/css/payment-fix.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Đảm bảo font chữ rõ ràng */
        body {
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
        }

        /* Đảm bảo nút hiển thị đúng */
        .btn-complete-payment {
            display: inline-block !important;
            background-color: #4CAF50 !important;
            color: white !important;
            opacity: 1 !important;
        }

        /* Đảm bảo hiển thị rõ chữ */
        h2.payment-title {
            color: #333 !important;
            font-size: 32px !important;
            font-weight: 700 !important;
            margin-bottom: 30px !important;
            text-align: center !important;
            opacity: 1 !important;
            text-shadow: none !important;
            font-family: Arial, sans-serif !important;
            letter-spacing: normal !important;
        }

        .payment-option {
            border: 2px solid #eee;
            border-radius: 8px;
            padding: 15px 20px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            cursor: pointer;
            background: #fafbfc;
            position: relative;
            transition: border-color 0.2s, background 0.2s;
        }

        .payment-option.selected {
            border-color: #4CAF50;
            background: #e8f5e9;
        }

        .payment-option input[type="radio"] {
            margin-right: 15px;
            accent-color: #4CAF50;
            width: 20px;
            height: 20px;
        }

        .payment-label {
            display: flex;
            align-items: center;
            font-size: 17px;
            font-weight: 500;
            color: #333;
        }

        .payment-label i {
            font-size: 22px;
            margin-right: 10px;
            color: #4CAF50;
        }

        .payment-option.selected::after {
            content: "\f00c";
            font-family: "Font Awesome 5 Free";
            font-weight: 900;
            color: #4CAF50;
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 20px;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <!-- Payment Section -->
    <section class="payment-section">
        <div class="container">
            <h2 class="payment-title">Thanh toán đặt tour</h2>
            <div class="payment-content">
                <!-- Thông tin đặt tour -->
                <div class="booking-summary">
                    <h3>Thông tin đặt tour</h3>
                    <div class="booking-details">
                        <div class="tour-image">
                            <img src="@tour?.MainImageUrl" alt="@tour?.Name_Tour">
                        </div>
                        <div class="tour-info">
                            <h4>@tour?.Name_Tour</h4>
                            <div class="booking-meta">
                                <p><i class="fas fa-calendar"></i> Ngày khởi hành:
                                    <span>@(((DateTime)booking.DepartureDate).ToString("dd/MM/yyyy"))</span>
                                </p>
                                <p><i class="fas fa-users"></i> Số lượng khách: <span>@booking.Quantity</span> người
                                </p>
                                <p><i class="fas fa-user"></i> Khách hàng: <span>@booking.FullName</span></p>
                                <p><i class="fas fa-phone"></i> Số điện thoại: <span>@booking.Phone</span></p>
                                <p><i class="fas fa-envelope"></i> Email: <span>@booking.Email</span></p>
                            </div>
                        </div>
                    </div>
                    <div class="price-summary">
                        <div class="price-row">
                            <span>Giá tour:</span>
                            <span>@((tour?.FinalPrice ?? 0).ToString("N0")) VND</span>
                        </div>
                        <div class="price-row">
                            <span>Số lượng:</span>
                            <span>@booking.Quantity người</span>
                        </div>
                        <div class="price-row total">
                            <span>Tổng tiền:</span>
                            <span>@(((decimal)booking.TotalPrice).ToString("N0")) VND</span>
                        </div>
                    </div>
                </div>

                <!-- Phương thức thanh toán -->
                <div class="payment-methods">
                    <h3>Phương thức thanh toán</h3>
                    <form asp-area="" asp-action="Payment" asp-controller="Payment" method="post">
                        @Html.AntiForgeryToken()
                        <div class="payment-options">
                            <div class="payment-option">
                                <input type="radio" name="payment_method" id="bank-transfer" value="bank_transfer"
                                    checked>
                                <label for="bank-transfer" class="payment-label">
                                    <i class="fas fa-university"></i>
                                    <span>Chuyển khoản ngân hàng</span>
                                </label>
                            </div>
                            <div class="payment-option">
                                <input type="radio" name="payment_method" id="cash" value="cash">
                                <label for="cash" class="payment-label">
                                    <i class="fas fa-money-bill-wave"></i>
                                    <span>Thanh toán tiền mặt</span>
                                </label>
                            </div>
                            <div class="payment-option">
                                <input type="radio" name="payment_method" id="momo" value="momo">
                                <label for="momo" class="payment-label">
                                    <i class="fas fa-wallet"></i>
                                    <span>Thanh toán qua MoMo</span>
                                </label>
                            </div>
                        </div>

                        <div class="agreement">
                            <input type="checkbox" id="terms-agreement" required>
                            <label for="terms-agreement">Tôi đã đọc và đồng ý với <a href="#">điều khoản đặt tour</a> và
                                <a href="#">chính sách hủy tour</a></label>
                        </div>

                        <div class="payment-actions">
                            <button type="button" class="btn-back" onclick="window.history.back();">Quay lại</button>
                            <button type="submit" class="btn-complete-payment">Hoàn tất đặt tour</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <div id="footer-placeholder"></div>

    <script src="/js/payment.js"></script>
    <script>
        document.querySelectorAll('.payment-option input[type="radio"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.querySelectorAll('.payment-option').forEach(function (opt) {
                    opt.classList.remove('selected');
                });
                this.closest('.payment-option').classList.add('selected');
            });
        });
        document.addEventListener('DOMContentLoaded', function () {
            var checked = document.querySelector('.payment-option input[type="radio"]:checked');
            if (checked) checked.closest('.payment-option').classList.add('selected');
        });
    </script>
</body>

</html>
