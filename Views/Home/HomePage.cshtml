<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EasyTrips - Du lịch khắp Việt Nam</title>
    
    <!-- CSS Files -->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/homepage.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
    <!-- Header -->
    <header class="fade-in">
        <div class="logo">
            <h1>EasyTrips</h1>
        </div>
        <nav>
            <ul>
                <li><a asp-controller="Home" asp-action="HomePage" class="active">Home</a></li>
                <li><a asp-controller="Tour" asp-action="ListTour">Tour</a></li>
                <li><a href="#">Destination</a></li>
                <li><a href="#">Evaluate</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
        </nav>
        
        <div class="header-right">
            <div class="search-icon">
                <i class="fas fa-search"></i>
            </div>
            
            <!-- Authentication Section -->
            <div class="auth-section">
                @if (User.Identity.IsAuthenticated)
                {
                    <!-- User is logged in -->
                    <div class="user-dropdown dropdown">
                        <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle"></i>
                            <span>@(User.Identity.Name)</span>
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="role-badge">Admin</span>
                            }
                            else if (User.IsInRole("TourGuide"))
                            {
                                <span class="role-badge">Guide</span>
                            }
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-user me-2"></i>Thông tin cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-history me-2"></i>Lịch sử đặt tour
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <a class="dropdown-item" href="/Admin/DashBoard/Index">
                                    <i class="fas fa-cog me-2"></i>Quản trị hệ thống
                                </a>
                            }
                            @if (User.IsInRole("TourGuide"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/TourGuide">
                                        <i class="fas fa-route me-2"></i>Quản lý tour
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <!-- User is not logged in -->
                    <div class="auth-buttons slide-in-right">
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-login">
                            <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                        </a>
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-register">
                            <i class="fas fa-user-plus me-2"></i>Đăng ký
                        </a>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content slide-in-left">
            <h2>Let's make a tour</h2>
            <h3>Discover the beauty</h3>

            <!-- Show different content based on authentication -->
            @if (User.Identity.IsAuthenticated)
            {
                <div class="welcome-message">
                    <h4>
                        <i class="fas fa-heart text-danger me-2"></i>
                        Chào mừng trở lại, @User.Identity.Name!
                    </h4>
                    <p>Hãy khám phá những tour du lịch tuyệt vời dành riêng cho bạn</p>
                </div>
            }

            <div class="search-form">
                <div class="form-row">
                    <div class="input-group">
                        <i class="fas fa-map-marker-alt"></i>
                        <input type="text" placeholder="From where">
                    </div>
                    <div class="input-group">
                        <i class="fas fa-map-marker-alt"></i>
                        <input type="text" placeholder="To where">
                    </div>
                </div>
                <div class="form-row">
                    <div class="input-group">
                        <i class="far fa-calendar"></i>
                        <input type="text" placeholder="mm/dd/yyyy">
                    </div>
                    <div class="input-group">
                        <i class="far fa-calendar"></i>
                        <input type="text" placeholder="mm/dd/yyyy">
                    </div>
                </div>
                <div class="form-row">
                    <button class="search-btn">
                        <i class="fas fa-search me-2"></i>Tìm kiếm tour
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Flash Deals Section -->
    <section class="deals fade-in">
        <div class="section-header">
            <h2>Flash Deals</h2>
            @if (!User.Identity.IsAuthenticated)
            {
                <div class="auth-prompt">
                    <a asp-area="Identity" asp-page="/Account/Login">
                        <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập để nhận ưu đãi đặc biệt!
                    </a>
                </div>
            }
        </div>
        
        <div class="carousel">
            <button class="carousel-btn prev"><i class="fas fa-chevron-left"></i></button>

            <div class="carousel-container">
                @{
                    var flashDeals = ViewBag.FlashDealTours as List<LAPTRINHWEB.Models.Tour>;
                }
                @if (flashDeals != null && flashDeals.Any())
                {
                    @foreach (var tour in flashDeals)
                    {
                        <div class="deal-card">
                            <a asp-controller="Tour" asp-action="Detail" asp-route-id="@tour.ID_Tour" class="tour-link">
                                <img src="@(tour.TourImages.FirstOrDefault()?.Image_URL ?? "/img/default-tour.jpg")"
                                    alt="@tour.Name_Tour" onerror="this.src='/img/default-tour.jpg'">
                                <div class="deal-info">
                                    <h3>@tour.Name_Tour</h3>
                                    <p>Thời gian: @tour.Duration ngày @(tour.Duration - 1) đêm</p>
                                    <p class="price">@tour.FinalPrice.ToString("N0") VND/người</p>
                                    @if (tour.Discount.HasValue && tour.Discount > 0)
                                    {
                                        <p class="discount">Giảm @tour.Discount.Value.ToString("N0") VND</p>
                                        <p class="original-price">@tour.Price.ToString("N0") VND</p>
                                    }
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <div class="member-badge">
                                            <i class="fas fa-star me-1"></i>Ưu đãi thành viên
                                        </div>
                                    }
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <!-- Fallback static content -->
                    <div class="deal-card">
                        <a asp-controller="Tour" asp-action="Detail" class="tour-link">
                            <img src="/img/gioi-thieu-ve-da-lat-1.jpg" alt="Đà Lạt">
                            <div class="deal-info">
                                <h3>Đà lạt</h3>
                                <p>Thời gian: 3-4 ngày</p>
                                <p class="price">2.990.000 VND/người</p>
                            </div>
                        </a>
                    </div>
                }
            </div>

            <button class="carousel-btn next"><i class="fas fa-chevron-right"></i></button>
        </div>
    </section>

    <!-- Popular Places Section -->
    <section class="popular-places fade-in">
        <h2>Popular places</h2>
        <div class="places-grid">
            @{
                var locations = ViewBag.PopularLocations as List<LAPTRINHWEB.Models.Location>;
            }
            @if (locations != null && locations.Any())
            {
                @for (int i = 0; i < locations.Count && i < 4; i++)
                {
                    var location = locations[i];
                    var cssClass = i == 0 ? "place-item large" : "place-item";

                    <div class="@cssClass">
                        <img src="/img/location-@(i + 1).jpg" alt="@location.Name"
                            onerror="this.src='/img/default-location.jpg'">
                        <div class="place-info">
                            <h4>@location.Name</h4>
                            <p>@location.Address</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Fallback static content -->
                <div class="place-item large">
                    <img src="/img/photo-1742300346757-a1d8f3d737ca.jpg" alt="Skyscraper">
                </div>
                <div class="place-item">
                    <img src="/img/R.png" alt="Temple">
                </div>
                <div class="place-item">
                    <img src="/img/pho-co-ha-noi-1698981164352290722974.png" alt="Old Quarter">
                </div>
            }
        </div>
        <button class="see-more" onclick="window.location.href='@Url.Action("ListTour", "Tour")'">Click to see more</button>
    </section>

    <!-- Popular Tour Section -->
    <section class="popular-tour fade-in">
        <h2>Popular tour</h2>
        <div class="tour-grid">
            @{
                var popularTours = ViewBag.PopularTours as List<LAPTRINHWEB.Models.Tour>;
            }
            @if (popularTours != null && popularTours.Any())
            {
                @foreach (var tour in popularTours.Take(4))
                {
                    <div class="tour-item">
                        <a asp-controller="Tour" asp-action="Detail" asp-route-id="@tour.ID_Tour">
                            <img src="@(tour.TourImages.FirstOrDefault()?.Image_URL ?? "/img/default-tour.jpg")"
                                alt="@tour.Name_Tour" onerror="this.src='/img/default-tour.jpg'">
                            <div class="tour-overlay">
                                <h4>@tour.Name_Tour</h4>
                                <p>@tour.Duration ngày @(tour.Duration - 1) đêm</p>
                                <p class="tour-price">@tour.FinalPrice.ToString("N0") VND/người</p>
                                @if (tour.Discount.HasValue && tour.Discount > 0)
                                {
                                    <span class="discount-badge">-@tour.Discount.Value.ToString("N0") VND</span>
                                }
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <span class="member-only">Thành viên</span>
                                }
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <!-- Fallback static content -->
                <div class="tour-item">
                    <img src="/img/unnamed.jpg" alt="River Tour">
                    <div class="tour-overlay">
                        <h4>River Tour</h4>
                        <p>3 ngày 2 đêm</p>
                        <p class="tour-price">2.500.000 VND/người</p>
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <div class="login-prompt">
                                <small><a asp-area="Identity" asp-page="/Account/Login">Đăng nhập để đặt tour</a></small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-column">
                <h3>Newsletter</h3>
                <p>Subscribe to our newsletter for updates, news, and exclusive offers.</p>
                <form class="newsletter-form">
                    <input type="email" placeholder="Your email">
                    <button type="submit">Subscribe</button>
                </form>
                <p class="privacy-note">By subscribing, you agree to our Privacy Policy and consent to receive updates.</p>
            </div>
        </div>
        <div class="copyright">
            <p>&copy; 2025 EasyTrips. All rights reserved.</p>
        </div>
    </footer>

    <!-- JavaScript Files -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>

</html>